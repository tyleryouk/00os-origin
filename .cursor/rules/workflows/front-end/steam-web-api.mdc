## Implementation Patterns

### Component Structure Pattern

```tsx
// Standard pattern for Steam component structure
import React from 'react';
import { useSteamAuth } from 'hooks/useSteamAuth';
import { useSteamInventory } from 'hooks/useSteamInventory';

const SteamComponent: React.FC = () => {
  const { user, isAuthenticated } = useSteamAuth();
  const { inventory, loading, error, refreshInventory } = useSteamInventory();
  
  // Component implementation
  
  return (
    <div>
      {/* Component content */}
    </div>
  );
};

export default SteamComponent;
```

### API Integration Pattern

```tsx
// Standard pattern for Steam API integration
import { apiClient } from 'api/apiClient';
import { cache } from 'utils/api-cache';
import { ConsolidatedLogger } from 'utils/consolidated-logger';

export const steamAPI = {
  // Method with caching and error handling
  getSomeData: cache(async (params) => {
    try {
      ConsolidatedLogger.log('INFO', 'STEAM', 'Fetching data from Steam API');
      const response = await apiClient.get('/steam/endpoint', { params });
      return response.data;
    } catch (error) {
      ConsolidatedLogger.logError(
        error instanceof Error ? error : new Error(String(error)),
        'steamAPI.getSomeData'
      );
      return null;
    }
  }, {
    ttl: 60 * 1000, // 1 minute cache
    cacheKeyFn: (params) => `steam-data-${JSON.stringify(params)}`
  })
};
```

### Error Handling Pattern

```tsx
// Standard pattern for Steam error handling
try {
  // Steam API operation
} catch (error) {
  if (error.response?.status === 429) {
    // Rate limiting error
    ConsolidatedLogger.logCS2('Rate limit exceeded', 'ERROR', { 
      source: 'steamOperation',
      retryAfter: error.response.headers['retry-after'] 
    });
    // Implement exponential backoff
  } else if (error.response?.status === 403) {
    // Authentication error
    ConsolidatedLogger.logCS2('Authentication failed', 'ERROR', { 
      source: 'steamOperation' 
    });
    // Redirect to login
  } else {
    // General error
    ConsolidatedLogger.logCS2Error(
      error instanceof Error ? error : new Error(String(error)),
      'steamOperation'
    );
    // Show error message
  }
}
``` 