### 1. Unwrapped @ Symbol Resolution

```bash
# Find and replace unwrapped @ symbols with backtick-wrapped versions
sed -i 's/@parameters\/rules\/([a-zA-Z0-9\-]+)\.mdc/`@parameters\/rules\/\1.mdc`/g' file.md
```

### 2. Incorrect Extension Resolution

```bash
# Find and replace .md with .mdc in project-rule-parameters
sed -i 's/@parameters\/rules\/([a-zA-Z0-9\-]+)\.md/`@parameters\/rules\/\1.mdc`/g' file.md
```

### 3. Path Standardization

```bash
# Find and replace bare @ references with full paths
sed -i 's/@([a-zA-Z0-9\-]+)\.mdc/`@parameters\/rules\/\1.mdc`/g' file.md
```

### 4. USE WHEN Header Resolution

```bash
# Add USE WHEN header to knowledge files missing it
for file in $(find 1000xbrain/knowledge -type f -name "*.md" -not -name "README.md"); do
  first_line=$(head -n 1 "$file")
  if [[ ! "$first_line" =~ ^#\ USE\ WHEN ]]; then
    # Determine appropriate header based on file path and content
    filename=$(basename "$file" .md)
    directory=$(dirname "$file" | xargs basename)
    
    # Generate context-appropriate header
    case "$directory" in
      "patterns")
        header="# USE WHEN implementing ${filename//-/ } patterns, optimizing ${filename//-/ } operations, or enhancing ${filename//-/ } functionality"
        ;;
      "guides")
        header="# USE WHEN understanding ${filename//-/ }, working with ${filename//-/ } components, or learning about ${filename//-/ } concepts"
        ;;
      "reference")
        header="# USE WHEN referencing ${filename//-/ }, documenting ${filename//-/ } structures, or organizing ${filename//-/ } information"
        ;;
      *)
        header="# USE WHEN working with ${filename//-/ }, implementing ${filename//-/ } functionality, or optimizing ${filename//-/ } operations"
        ;;
    esac
    
    # Add header to file
    temp_file=$(mktemp)
    echo "$header" > "$temp_file"
    cat "$file" >> "$temp_file"
    mv "$temp_file" "$file"
    echo "Added USE WHEN header to $file"
  fi
done
```

### 5. README.md Creation

```bash
# Create README.md files in directories missing them
for dir in $(find 1000xbrain -type d -not -path "*/\.*"); do
  if [ ! -f "$dir/README.md" ]; then
    # Determine appropriate README.md content based on directory
    directory=$(basename "$dir")
    parent=$(dirname "$dir" | xargs basename)
    
    # Generate context-appropriate README content
    case "$parent/$directory" in
      "1000xbrain/knowledge")
        content="# Knowledge Directory\n\nThis directory contains Agent Requested rules accessed through the fetch_rules tool.\n\n## Requirements\n\n- All files must begin with a USE WHEN header\n- Files should follow knowledge organization standards\n- Access is through fetch_rules tool only"
        ;;
      "knowledge/rules/patterns")
        content="# Patterns Directory\n\nThis directory contains implementation patterns for various domains.\n\n## Requirements\n\n- All files must begin with a USE WHEN header\n- Pattern files should follow established pattern format\n- Each pattern should include examples and usage guidance"
        ;;
      *)
        content="# $directory Directory\n\nThis directory contains files related to $directory functionality.\n\n## Requirements\n\n- Follow consistent formatting standards\n- Maintain architectural integrity\n- Update related documentation when changing files"
        ;;
    esac
    
    # Create README.md file
    echo -e "$content" > "$dir/README.md"
    echo "Created README.md in $dir"
  fi
done
```

