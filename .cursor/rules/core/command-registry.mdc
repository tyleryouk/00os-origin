## Command Registry File

The registry maintains a dynamic index of all commands in the system, but it can also be exported to a JSON file for faster loading:

```javascript
/**
 * Export the registry to JSON
 * @param {string} filePath - Path to save the registry JSON
 * @returns {Promise<boolean>} Success status
 */
async function exportRegistryToJson(filePath = '/00os/processes/system/command-registry.json') {
  try {
    // Prepare registry data
    const registryData = {
      commands: Object.fromEntries(commandDefinitions),
      aliases: Object.fromEntries(commandAliases),
      categories: Array.from(commandCategories)
    };
    
    // Serialize to JSON
    const json = JSON.stringify(registryData, null, 2);
    
    // Write to file
    await writeFile(filePath, json);
    
    return true;
  } catch (error) {
    console.error('Error exporting registry:', error);
    return false;
  }
}

/**
 * Import registry from JSON
 * @param {string} filePath - Path to registry JSON file
 * @returns {Promise<boolean>} Success status
 */
async function importRegistryFromJson(filePath = '/00os/processes/system/command-registry.json') {
  try {
    // Read file
    const json = await readFile(filePath);
    
    // Parse JSON
    const registryData = JSON.parse(json);
    
    // Clear existing registry
    commandDefinitions.clear();
    commandAliases.clear();
    commandCategories.clear();
    
    // Import commands
    for (const [name, command] of Object.entries(registryData.commands)) {
      commandDefinitions.set(name, command);
    }
    
    // Import aliases
    for (const [alias, command] of Object.entries(registryData.aliases)) {
      commandAliases.set(alias, command);
    }
    
    // Import categories
    for (const category of registryData.categories) {
      commandCategories.add(category);
    }
    
    return true;
  } catch (error) {
    console.error('Error importing registry:', error);
    return false;
  }
}
```

## Integration with Command Handler

The Command Registry integrates with the Command Handler to provide command lookup and validation:

```javascript
/**
 * Check if a command exists
 * @param {string} command - Command to check
 * @returns {boolean} Whether the command exists
 */
function checkCommandExists(command) {
  return hasCommand(command);
}

/**
 * Get a validator for a command
 * @param {string} command - Command name
 * @returns {Function|null} Validator function or null
 */
function getCommandValidator(command) {
  // Get command definition
  const commandDef = getCommand(command);
  
  // Use custom validator if provided
  if (commandDef && commandDef.validator) {
    return commandDef.validator;
  }
  
  // Create default validator based on command rules
  return createCommandValidator(command);
}

/**
 * Get command shortcuts
 * @returns {Object} Map of shortcuts to commands
 */
function getCommandShortcuts() {
  return getAllAliases();
}
```

## Command Versioning

The registry supports command versioning to track changes and ensure compatibility:

```javascript
/**
 * Get command version
 * @param {string} command - Command name
 * @returns {string|null} Command version or null if not found
 */
function getCommandVersion(command) {
  const commandDef = getCommand(command);
  return commandDef ? commandDef.version : null;
}

/**
 * Check if command version meets minimum requirement
 * @param {string} command - Command name
 * @param {string} minVersion - Minimum version required
 * @returns {boolean} Whether command meets version requirement
 */
function checkCommandVersion(command, minVersion) {
  const version = getCommandVersion(command);
  
  if (!version) {
    return false;
  }
  
  // Compare versions (simple implementation)
  const [major1, minor1, patch1] = version.split('.').map(Number);
  const [major2, minor2, patch2] = minVersion.split('.').map(Number);
  
  if (major1 > major2) return true;
  if (major1 < major2) return false;
  
  if (minor1 > minor2) return true;
  if (minor1 < minor2) return false;
  
  return patch1 >= patch2;
}
```

## Command Dependencies

The registry can track command dependencies to ensure required commands are available:

```javascript
/**
 * Check command dependencies
 * @param {string} command - Command name
 * @returns {Object} Dependency check result
 */
function checkCommandDependencies(command) {
  const commandDef = getCommand(command);
  
  if (!commandDef || !commandDef.dependencies) {
    return { satisfied: true };
  }
  
  const missingDependencies = [];
  const versionMismatches = [];
  
  // Check each dependency
  for (const [depName, depVersion] of Object.entries(commandDef.dependencies)) {
    if (!hasCommand(depName)) {
      missingDependencies.push(depName);
    } else if (!checkCommandVersion(depName, depVersion)) {
      versionMismatches.push({
        name: depName,
        required: depVersion,
        available: getCommandVersion(depName)
      });
    }
  }
  
  return {
    satisfied: missingDependencies.length === 0 && versionMismatches.length === 0,
    missingDependencies,
    versionMismatches
  };
}
```

