## Tool Call Sequence

When this parameter is used, follow this exact sequence:

```typescript
// 1. Read implementation progress and context files
read_file("[planning_folder_path]/implementation-progress.md", should_read_entire_file=true)
read_file("[planning_folder_path]/README.md", should_read_entire_file=true)
read_file("[planning_folder_path]/requirements.md", should_read_entire_file=true)

// 2. Read rules-workflow enhancement implementation plan
read_file("[planning_folder_path]/implementation-rules-enhancement.md", should_read_entire_file=true)
read_file("[planning_folder_path]/context-rules-enhancement.md", should_read_entire_file=true)
read_file("[planning_folder_path]/context-rules-patterns.md", should_read_entire_file=true)

// 3. Check if documentation verification exists
list_dir("[planning_folder_path]")
if (file_exists("[planning_folder_path]/documentation-verification.md")) {
  read_file("[planning_folder_path]/documentation-verification.md", should_read_entire_file=true)
}

// 4. Analyze current documentation state
read_file("1000xbrain/workflows/rules-workflow/README.md", should_read_entire_file=true)
read_file("1000xbrain/workflows/rules-workflow/[current_target_doc].md", should_read_entire_file=true)

// 5. Determine current implementation phase and state
// Based on implementation-progress.md and file state analysis

// 6. Report enhancement state and continuation plan
// "Rules-workflow enhancement implementation is at phase X"
// "Continuing to Phase Y: [Phase Description]"
// "Documentation files to be enhanced: [list]"

// 7. Update implementation progress with continuation information
edit_file("[planning_folder_path]/implementation-progress.md",
          "Update implementation progress for continuation",
          "// ... existing content ...\n\n## Continuation Point\n- Date: [current date]\n- Continuing from: Phase X, Step Y\n- Reason: [continuation reason]\n\n// ... existing content ...")

// 8. Continue implementation based on determined state
// Either proceed to next phase or resume current phase
```

## Enhanced Implementation State Detection

### 1. Progress Analysis

```typescript
// Read implementation progress
read_file("[planning_folder_path]/implementation-progress.md", should_read_entire_file=true)

// Parse current phase and step
// Format typically follows:
// ## Current Status
// - Phase: [number]
// - Step: [step description]

// Check for completion markers
grep_search("\[x\]", false, "[planning_folder_path]/implementation-progress.md")
grep_search("- Phase [0-9]+:.*\[complete", false, "[planning_folder_path]/implementation-progress.md")

// Look for continuation points
grep_search("Continuation Point", false, "[planning_folder_path]/implementation-progress.md")
```

### 2. Documentation State Verification

```typescript
// Check for main documentation files
read_file("1000xbrain/workflows/rules-workflow/README.md", should_read_entire_file=true)

// Check for message-command documentation
if (target_includes_message_commands) {
  read_file("1000xbrain/workflows/rules-workflow/message-commands-reference.md", should_read_entire_file=true)
}

// Check for tool pattern documentation
if (target_includes_tool_patterns) {
  read_file("1000xbrain/workflows/rules-workflow/rules-workflow-cheatsheet.md", should_read_entire_file=true)
}

// Check for self-referential documentation
if (target_includes_self_referential) {
  read_file("1000xbrain/workflows/rules-workflow/self-referential-enhancement.md", should_read_entire_file=true)
}

// Check rules implementations for comparison
if (target_includes_parameters) {
  list_dir("1000xbrain/parameters/rules")
  read_file("1000xbrain/parameters/rules/[parameter_folder]/[referenced_parameter].md", should_read_entire_file=true)
}
```

### 3. Continuation Point Determination

Based on the analysis:

```typescript
// If a phase is complete, move to next phase
if (current_phase_complete) {
  next_phase = current_phase + 1
  
  // Update implementation progress
  edit_file("[planning_folder_path]/implementation-progress.md",
            "Update implementation progress for next phase",
            "// ... existing content ...\n\n## Continuation to Next Phase\n- Moving from Phase [current_phase] to Phase [next_phase]\n- Date: [current date]\n\n## Current Status\n- Phase: [next_phase]\n- Step: 1\n- Last Update: [timestamp]\n\n// ... rest of content ...")
}
// If phase is incomplete, continue from current point
else {
  // Update implementation progress with continuation point
  edit_file("[planning_folder_path]/implementation-progress.md",
            "Update implementation progress with continuation point",
            "// ... existing content ...\n\n## Continuation Within Phase\n- Continuing Phase [current_phase]\n- Resuming from Step [current_step]\n- Date: [current date]\n\n// ... rest of content ...")
}
```

