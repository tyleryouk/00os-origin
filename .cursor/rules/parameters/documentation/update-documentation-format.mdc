UserController.get_user_by_id, methods=[\"GET\"])\nuser_router.add_api_route(\"/{user_id}\", UserController.update_user, methods=[\"PUT\"])\nuser_router.add_api_route(\"/{user_id}\", UserController.delete_user, methods=[\"DELETE\"])\n\n# Auth Routes\nauth_router = APIRouter(prefix=\"/auth\", tags=[\"auth\"])\nauth_router.add_api_route(\"/login\", AuthController.login, methods=[\"POST\"])\nauth_router.add_api_route(\"/register\", AuthController.register, methods=[\"POST\"])\nauth_router.add_api_route(\"/refresh\", AuthController.refresh_token, methods=[\"POST\"])\nauth_router.add_api_route(\"/logout\", AuthController.logout, methods=[\"POST\"])\n\n# Include all routers in the main API router\napi_router.include_router(order_router)\napi_router.include_router(user_router)\napi_router.include_router(auth_router)\n```\n\n## API Endpoint Reference\n\n### Orders API\n\n| Endpoint | Method | Purpose | Authentication |\n|----------|--------|---------|----------------|\n| `/api/orders` | GET | Retrieve all orders | Required |\n| `/api/orders` | POST | Create a new order | Required |\n| `/api/orders/{order_id}` | GET | Retrieve specific order | Required |\n| `/api/orders/{order_id}` | PUT | Update an order | Required |\n| `/api/orders/{order_id}` | DELETE | Delete an order | Required |\n\n### Users API\n\n| Endpoint | Method | Purpose | Authentication |\n|----------|--------|---------|----------------|\n| `/api/users` | GET | Retrieve all users | Admin only |\n| `/api/users` | POST | Create a new user | Admin only |\n| `/api/users/{user_id}` | GET | Retrieve specific user | Required |\n| `/api/users/{user_id}` | PUT | Update a user | Required (self) or Admin |\n| `/api/users/{user_id}` | DELETE | Delete a user | Admin only |\n\n### Auth API\n\n| Endpoint | Method | Purpose | Authentication |\n|----------|--------|---------|----------------|\n| `/api/auth/login` | POST | Authenticate user | None |\n| `/api/auth/register` | POST | Register new user | None |\n| `/api/auth/refresh` | POST | Refresh access token | Required (refresh token) |\n| `/api/auth/logout` | POST | Invalidate tokens | Required |\n\n## Error Handling\n\nAll API routes use a consistent error handling approach:\n\n```python\ntry:\n    # Route handler logic\n    return successful_response\nexcept ValidationError as e:\n    # Handle validation errors (HTTP 400)\n    return JSONResponse(status_code=400, content={\"error\": str(e)})\nexcept AuthenticationError as e:\n    # Handle authentication errors (HTTP 401)\n    return JSONResponse(status_code=401, content={\"error\": str(e)})\nexcept PermissionError as e:\n    # Handle permission errors (HTTP 403)\n    return JSONResponse(status_code=403, content={\"error\": str(e)})\nexcept ResourceNotFoundError as e:\n    # Handle not found errors (HTTP 404)\n    return JSONResponse(status_code=404, content={\"error\": str(e)})\nexcept Exception as e:\n    # Handle unexpected errors (HTTP 500)\n    logger.error(f\"Unexpected error: {str(e)}\")\n    return JSONResponse(status_code=500, content={\"error\": \"Internal server error\"})\n```\n\n## Related Components\n\n- [Controllers](./controllers.md) - Controller implementations for all routes\n- [Middleware](./middleware.md) - API middleware for authentication and logging\n- [Models](./models.md) - Pydantic models used in the API")

