## Common Error Recovery Patterns

### 1. Null Reference Error Recovery

```typescript
// Before: Error-prone code
const renderItem = () => {
  return data.items.map(item => (
    <Item key={item.id} name={item.name} />
  ));
};

// After: With error recovery
const renderItem = () => {
  if (!data || !data.items) {
    return <div className="error-state">No items available</div>;
  }
  
  return data.items.map(item => (
    <Item 
      key={item?.id || `item-${Math.random()}`} 
      name={item?.name || 'Unnamed item'} 
    />
  ));
};
```

### 2. API Error Recovery Pattern

```typescript
// Before: Error-prone API handling
const fetchData = async () => {
  setLoading(true);
  const response = await fetch(apiUrl);
  const data = await response.json();
  setData(data);
  setLoading(false);
};

// After: With error recovery
const fetchData = async () => {
  setLoading(true);
  setError(null);
  
  try {
    const response = await fetch(apiUrl);
    
    if (!response.ok) {
      throw new Error(`API error: ${response.status} ${response.statusText}`);
    }
    
    const data = await response.json();
    setData(data);
  } catch (error) {
    console.error('API request failed:', error);
    setError(error.message || 'Failed to fetch data');
    // Fallback data if applicable
    setData(previousData || []);
  } finally {
    setLoading(false);
  }
};
```

### 3. State Management Error Recovery

```typescript
// Before: Error-prone state update
const handleUpdate = (id, newValue) => {
  const updatedItems = items.map(item => {
    if (item.id === id) {
      return { ...item, value: newValue };
    }
    return item;
  });
  setItems(updatedItems);
};

// After: With error recovery
const handleUpdate = (id, newValue) => {
  if (id === undefined || newValue === undefined) {
    console.error('Invalid update parameters:', { id, newValue });
    return;
  }
  
  try {
    setItems(prevItems => {
      if (!Array.isArray(prevItems)) {
        console.error('Previous items not an array:', prevItems);
        return []; // Reset to empty array
      }
      
      return prevItems.map(item => {
        if (item?.id === id) {
          return { ...item, value: newValue };
        }
        return item;
      });
    });
  } catch (error) {
    console.error('State update error:', error);
    // Recover by forcing re-fetch or reset
  }
};
```

### 4. Error Boundary Implementation

```typescript
// Error boundary component
import React, { Component } from 'react';

interface ErrorBoundaryProps {
  fallback?: React.ReactNode;
  onError?: (error: Error, errorInfo: React.ErrorInfo) => void;
  resetKeys?: any[];
  children: React.ReactNode;
}

interface ErrorBoundaryState {
  hasError: boolean;
  error: Error | null;
}

class ErrorBoundary extends Component<ErrorBoundaryProps, ErrorBoundaryState> {
  constructor(props: ErrorBoundaryProps) {
    super(props);
    this.state = { hasError: false, error: null };
  }

  static getDerivedStateFromError(error: Error) {
    return { hasError: true, error };
  }

  componentDidCatch(error: Error, errorInfo: React.ErrorInfo) {
    console.error('Component error:', error, errorInfo);
    if (this.props.onError) {
      this.props.onError(error, errorInfo);
    }
  }

  componentDidUpdate(prevProps: ErrorBoundaryProps) {
    if (this.state.hasError && this.props.resetKeys) {
      // Check if any reset keys changed
      const hasKeyChanged = this.props.resetKeys.some(
        (key, index) => key !== prevProps.resetKeys?.[index]
      );
      
      if (hasKeyChanged) {
        this.setState({ hasError: false, error: null });
      }
    }
  }

  render() {
    if (this.state.hasError) {
      if (this.props.fallback) {
        return this.props.fallback;
      }
      return (
        <div className="error-boundary">
          <h3>Something went wrong</h3>
          <details>
            <summary>Error details</summary>
            <pre>{this.state.error?.toString()}</pre>
          </details>
          <button onClick={() => this.setState({ hasError: false, error: null })}>
            Retry
          </button>
        </div>
      );
    }

    return this.props.children;
  }
}

// Usage
const SafeComponent = () => (
  <ErrorBoundary 
    fallback={<div>Something went wrong. Please try again.</div>}
    onError={(error) => logErrorToService(error)}
    resetKeys={[someStateVariable]}
  >
    <ComponentThatMightError />
  </ErrorBoundary>
);
```

## Recovery Implementation

Implement error fixes systematically:

```typescript
// 1. For component with errors
read_file("[component_with_error_path]", should_read_entire_file=true)

// 2. Apply error fix
edit_file("[component_with_error_path]",
          "Fix error in component",
          "// ... existing code ...\n\n// Error fix: Added proper null checking and fallback\n// ... fixed implementation code ...")

// 3. Add error boundary
edit_file("[parent_component_path]",
          "Add error boundary",
          "import { ErrorBoundary } from '../components/ErrorBoundary';\n\n// ... existing code ...\n\nreturn (\n  <ErrorBoundary>\n    {/* Component that might error */}\n  </ErrorBoundary>\n);\n\n// ... existing code ...")

// 4. Implement form validation
edit_file("[form_component_path]",
          "Add form validation to prevent errors",
          "// ... existing code ...\n\n// Validation to prevent errors\nconst validateInput = (value) => {\n  if (!value) return 'Value is required';\n  if (value.length < 3) return 'Value must be at least 3 characters';\n  return null;\n};\n\n// ... existing code ...")
```

