## Advanced Recovery Strategies

### 1. Component Hierarchy Recovery

```typescript
// Before: Problematic component hierarchy with prop drilling
const ParentComponent = () => {
  const [data, setData] = useState([]);
  // Passing data through multiple levels
  return <MiddleComponent data={data} setData={setData} />;
};

// After: With context-based architecture
const DataContext = createContext(null);

const DataProvider = ({ children }) => {
  const [data, setData] = useState([]);
  return (
    <DataContext.Provider value={{ data, setData }}>
      {children}
    </DataContext.Provider>
  );
};

const ParentComponent = () => {
  return (
    <DataProvider>
      <MiddleComponent />
    </DataProvider>
  );
};

const ChildComponent = () => {
  const { data, setData } = useContext(DataContext);
  // Now directly accessing data without prop drilling
};
```

### 2. State Management Recovery

```typescript
// Before: Complex state with multiple useState calls
const Component = () => {
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);
  const [data, setData] = useState([]);
  const [selectedId, setSelectedId] = useState(null);
  const [filters, setFilters] = useState({});
  // Complex state interactions...
};

// After: With reducer pattern
const initialState = {
  loading: false,
  error: null,
  data: [],
  selectedId: null,
  filters: {},
};

const reducer = (state, action) => {
  switch (action.type) {
    case 'FETCH_START':
      return { ...state, loading: true, error: null };
    case 'FETCH_SUCCESS':
      return { ...state, loading: false, data: action.payload };
    case 'FETCH_ERROR':
      return { ...state, loading: false, error: action.payload };
    case 'SELECT_ITEM':
      return { ...state, selectedId: action.payload };
    case 'UPDATE_FILTERS':
      return { ...state, filters: { ...state.filters, ...action.payload } };
    default:
      return state;
  }
};

const Component = () => {
  const [state, dispatch] = useReducer(reducer, initialState);
  // Simplified state management with actions
};
```

### 3. Performance Recovery Strategy

```typescript
// Before: Performance issues with excessive rerenders
const Component = ({ data, onAction }) => {
  // Recreated on every render
  const processData = () => {
    return data.map(item => ({ ...item, processed: true }));
  };
  
  // New function reference on every render
  const handleClick = () => {
    onAction(data);
  };
  
  return (
    <>
      {processData().map(item => (
        <Item key={item.id} item={item} onClick={handleClick} />
      ))}
    </>
  );
};

// After: With performance optimizations
const Component = ({ data, onAction }) => {
  // Memoized data processing
  const processedData = useMemo(() => {
    return data.map(item => ({ ...item, processed: true }));
  }, [data]);
  
  // Memoized callback
  const handleClick = useCallback(() => {
    onAction(data);
  }, [data, onAction]);
  
  return (
    <>
      {processedData.map(item => (
        <Item key={item.id} item={item} onClick={handleClick} />
      ))}
    </>
  );
};

// Prevent child components from unnecessary rerenders
const Item = memo(({ item, onClick }) => {
  return <div onClick={onClick}>{item.name}</div>;
});
```

