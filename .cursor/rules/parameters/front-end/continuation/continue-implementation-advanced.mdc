## Advanced Component Patterns

When implementing advanced front-end patterns, use these structured approaches:

### 1. Advanced Component Composition Pattern

```typescript
// Component composition with render props and HOCs
import React, { useState, useEffect, useCallback } from 'react';
import { withErrorBoundary } from 'error-boundary-hoc';
import { useSomeContext } from 'contexts';
import { LazyComponent } from './lazy-loading';
import styles from './styles.module.css';

interface ComponentProps {
  id: string;
  data?: Record<string, any>;
  onAction: (id: string, data: any) => void;
  renderCustomContent?: (data: any) => React.ReactNode;
  isLoading?: boolean;
  isDisabled?: boolean;
}

export const BaseComponent: React.FC<ComponentProps> = ({
  id,
  data,
  onAction,
  renderCustomContent,
  isLoading = false,
  isDisabled = false,
}) => {
  // Context integration
  const contextValue = useSomeContext();
  
  // Memoized callback
  const handleAction = useCallback(
    (actionData: any) => {
      if (!isDisabled) {
        onAction(id, actionData);
      }
    },
    [id, onAction, isDisabled]
  );
  
  // Conditional rendering
  if (isLoading) {
    return <div className={styles.loading}>Loading...</div>;
  }
  
  // Composition with render props
  return (
    <div className={styles.container} data-testid={`component-${id}`}>
      <div className={styles.header}>
        {contextValue.title}
      </div>
      <div className={styles.content}>
        {data && Object.keys(data).length > 0 ? (
          <>
            <div className={styles.defaultContent}>
              {/* Default rendering */}
            </div>
            {renderCustomContent && (
              <div className={styles.customContent}>
                {renderCustomContent(data)}
              </div>
            )}
          </>
        ) : (
          <div className={styles.emptyState}>No data available</div>
        )}
      </div>
      <LazyComponent data={data} onAction={handleAction} />
    </div>
  );
};

// Export with HOC
export const Component = withErrorBoundary(BaseComponent);
```

### 2. Advanced State Management Pattern

```typescript
// Advanced context with reducer pattern
import React, { createContext, useContext, useReducer, useCallback, useEffect } from 'react';
import { API } from '../services/api';

// State type definitions
export interface FeatureState {
  data: Record<string, any>[];
  isLoading: boolean;
  error: Error | null;
  selectedId: string | null;
  filters: Record<string, any>;
  pagination: {
    page: number;
    limit: number;
    total: number;
  };
}

// Action type definitions
type Action =
  | { type: 'FETCH_START' }
  | { type: 'FETCH_SUCCESS'; payload: Record<string, any>[] }
  | { type: 'FETCH_ERROR'; payload: Error }
  | { type: 'SELECT_ITEM'; payload: string }
  | { type: 'UPDATE_FILTERS'; payload: Record<string, any> }
  | { type: 'UPDATE_PAGINATION'; payload: Partial<FeatureState['pagination']> };

// Context type
interface FeatureContextType extends FeatureState {
  fetchData: () => Promise<void>;
  selectItem: (id: string) => void;
  updateFilters: (filters: Record<string, any>) => void;
  updatePagination: (pagination: Partial<FeatureState['pagination']>) => void;
}

// Initial state
const initialState: FeatureState = {
  data: [],
  isLoading: false,
  error: null,
  selectedId: null,
  filters: {},
  pagination: {
    page: 1,
    limit: 10,
    total: 0,
  },
};

// Reducer function
const reducer = (state: FeatureState, action: Action): FeatureState => {
  switch (action.type) {
    case 'FETCH_START':
      return { ...state, isLoading: true, error: null };
    case 'FETCH_SUCCESS':
      return { 
        ...state, 
        isLoading: false, 
        data: action.payload,
        pagination: {
          ...state.pagination,
          total: action.payload.length,
        },
      };
    case 'FETCH_ERROR':
      return { ...state, isLoading: false, error: action.payload };
    case 'SELECT_ITEM':
      return { ...state, selectedId: action.payload };
    case 'UPDATE_FILTERS':
      return { 
        ...state, 
        filters: { ...state.filters, ...action.payload },
        pagination: { ...state.pagination, page: 1 }, // Reset to first page
      };
    case 'UPDATE_PAGINATION':
      return { 
        ...state, 
        pagination: { ...state.pagination, ...action.payload },
      };
    default:
      return state;
  }
};

// Create context
const FeatureContext = createContext<FeatureContextType | null>(null);

// Provider component
export const FeatureProvider: React.FC = ({ children }) => {
  const [state, dispatch] = useReducer(reducer, initialState);
  
  // Actions
  const fetchData = useCallback(async () => {
    dispatch({ type: 'FETCH_START' });
    try {
      const { page, limit } = state.pagination;
      const result = await API.fetchData({
        page,
        limit,
        ...state.filters,
      });
      dispatch({ type: 'FETCH_SUCCESS', payload: result.data });
    } catch (error) {
      dispatch({ type: 'FETCH_ERROR', payload: error });
    }
  }, [state.pagination, state.filters]);
  
  const selectItem = useCallback((id: string) => {
    dispatch({ type: 'SELECT_ITEM', payload: id });
  }, []);
  
  const updateFilters = useCallback((filters: Record<string, any>) => {
    dispatch({ type: 'UPDATE_FILTERS', payload: filters });
  }, []);
  
  const updatePagination = useCallback((pagination: Partial<FeatureState['pagination']>) => {
    dispatch({ type: 'UPDATE_PAGINATION', payload: pagination });
  }, []);
  
  // Effects
  useEffect(() => {
    fetchData();
  }, [fetchData, state.pagination.page, state.pagination.limit]);
  
  // Context value
  const value: FeatureContextType = {
    ...state,
    fetchData,
    selectItem,
    updateFilters,
    updatePagination,
  };
  
  return (
    <FeatureContext.Provider value={value}>
      {children}
    </FeatureContext.Provider>
  );
};

// Hook for consuming context
export const useFeature = (): FeatureContextType => {
  const context = useContext(FeatureContext);
  if (context === null) {
    throw new Error('useFeature must be used within a FeatureProvider');
  }
  return context;
};
```

### 3. Advanced API Integration Pattern

```typescript
// Advanced API hook pattern with SWR or React Query
import { useQuery, useMutation, useQueryClient } from 'react-query';
import { API } from '../services/api';

// Types
interface QueryOptions {
  enabled?: boolean;
  refetchInterval?: number;
  refetchOnWindowFocus?: boolean;
  onSuccess?: (data: any) => void;
  onError?: (error: Error) => void;
}

export const useFeatureData = (id: string, options: QueryOptions = {}) => {
  // QueryClient for cache management
  const queryClient = useQueryClient();
  
  // Fetch data query
  const {
    data,
    isLoading,
    error,
    refetch,
    isRefetching,
  } = useQuery(
    ['featureData', id],
    () => API.fetchFeatureData(id),
    {
      enabled: !!id,
      refetchOnWindowFocus: true,
      staleTime: 5 * 60 * 1000, // 5 minutes
      cacheTime: 10 * 60 * 1000, // 10 minutes
      ...options,
    }
  );
  
  // Update data mutation
  const updateMutation = useMutation(
    (newData: any) => API.updateFeatureData(id, newData),
    {
      onMutate: async (newData) => {
        // Cancel outgoing refetches to avoid overwriting optimistic update
        await queryClient.cancelQueries(['featureData', id]);
        
        // Snapshot previous value
        const previousData = queryClient.getQueryData(['featureData', id]);
        
        // Optimistically update cache
        queryClient.setQueryData(['featureData', id], (old: any) => ({
          ...old,
          ...newData,
        }));
        
        // Return previous value for rollback
        return { previousData };
      },
      onError: (err, variables, context) => {
        // Rollback to previous value on error
        if (context?.previousData) {
          queryClient.setQueryData(['featureData', id], context.previousData);
        }
      },
      onSettled: () => {
        // Refetch to ensure consistency
        queryClient.invalidateQueries(['featureData', id]);
      },
    }
  );
  
  // Delete data mutation
  const deleteMutation = useMutation(
    () => API.deleteFeatureData(id),
    {
      onSuccess: () => {
        // Remove from cache and invalidate related queries
        queryClient.removeQueries(['featureData', id]);
        queryClient.invalidateQueries('featureList');
      },
    }
  );
  
  return {
    data,
    isLoading,
    isRefetching,
    error,
    refetch,
    updateData: updateMutation.mutate,
    isUpdating: updateMutation.isLoading,
    updateError: updateMutation.error,
    deleteData: deleteMutation.mutate,
    isDeleting: deleteMutation.isLoading,
    deleteError: deleteMutation.error,
  };
};
```

