## Immediate Stabilization Strategies

### 1. Global Error Boundary Implementation

```typescript
// Create root error boundary for application stability
import React, { Component } from 'react';

interface FallbackProps {
  error: Error;
  resetErrorBoundary: () => void;
}

interface ErrorBoundaryProps {
  fallback: React.ComponentType<FallbackProps>;
  onError?: (error: Error, info: React.ErrorInfo) => void;
  onReset?: () => void;
  children: React.ReactNode;
}

interface ErrorBoundaryState {
  hasError: boolean;
  error: Error | null;
}

export class ErrorBoundary extends Component<ErrorBoundaryProps, ErrorBoundaryState> {
  constructor(props: ErrorBoundaryProps) {
    super(props);
    this.state = { 
      hasError: false, 
      error: null 
    };
  }

  static getDerivedStateFromError(error: Error): ErrorBoundaryState {
    return { 
      hasError: true, 
      error 
    };
  }

  componentDidCatch(error: Error, info: React.ErrorInfo) {
    // Log error to service
    console.error('Critical error caught by boundary:', error, info);
    
    // Call onError if provided
    if (this.props.onError) {
      this.props.onError(error, info);
    }
    
    // Log to monitoring service
    if (window.logErrorToService) {
      window.logErrorToService(error, {
        componentStack: info.componentStack,
        boundary: 'RootErrorBoundary'
      });
    }
  }

  resetErrorBoundary = () => {
    if (this.props.onReset) {
      this.props.onReset();
    }
    this.setState({ 
      hasError: false, 
      error: null 
    });
  };

  render() {
    if (this.state.hasError && this.state.error) {
      const FallbackComponent = this.props.fallback;
      return (
        <FallbackComponent
          error={this.state.error}
          resetErrorBoundary={this.resetErrorBoundary}
        />
      );
    }

    return this.props.children;
  }
}

// Fallback component
const ErrorFallback: React.FC<FallbackProps> = ({ 
  error, 
  resetErrorBoundary 
}) => {
  return (
    <div role="alert" className="error-fallback">
      <h2>Something went wrong</h2>
      <pre className="error-message">{error.message}</pre>
      <button onClick={resetErrorBoundary}>Try again</button>
    </div>
  );
};

// Application wrapper
const App = () => {
  return (
    <ErrorBoundary fallback={ErrorFallback} onError={logErrorToMonitoring}>
      <AppContent />
    </ErrorBoundary>
  );
};
```

### 2. Critical API Recovery Strategy

```typescript
// Implement API resilience for critical endpoints
const criticalApiCall = async (endpoint, options = {}) => {
  const MAX_RETRIES = 3;
  const RETRY_DELAY = 1000;
  
  // Setup fallback cache if available
  const useFallbackCache = options.useFallbackCache ?? true;
  const fallbackCache = window.localStorage.getItem(`api_fallback_${endpoint}`);
  
  // Retry function with exponential backoff
  const retryWithBackoff = async (attempt = 0) => {
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 10000); // 10s timeout
      
      const response = await fetch(endpoint, {
        ...options,
        signal: controller.signal,
        headers: {
          ...options.headers,
          'X-Retry-Attempt': attempt
        }
      });
      
      clearTimeout(timeoutId);
      
      if (!response.ok) {
        throw new Error(`API error: ${response.status} ${response.statusText}`);
      }
      
      const data = await response.json();
      
      // Cache successful response for fallback
      if (useFallbackCache) {
        try {
          window.localStorage.setItem(`api_fallback_${endpoint}`, JSON.stringify({
            data,
            timestamp: Date.now()
          }));
        } catch (cacheError) {
          console.warn('Failed to cache API response:', cacheError);
        }
      }
      
      return { data, source: 'network' };
    } catch (error) {
      console.error(`API request failed (attempt ${attempt + 1}/${MAX_RETRIES}):`, error);
      
      // If we've tried enough times or it's a network error during critical recovery
      if (attempt >= MAX_RETRIES - 1) {
        // Try to use cached data as fallback
        if (useFallbackCache && fallbackCache) {
          try {
            const cachedData = JSON.parse(fallbackCache);
            console.warn(`Using cached data from ${new Date(cachedData.timestamp)}`);
            return { data: cachedData.data, source: 'cache' };
          } catch (cacheError) {
            console.error('Failed to parse cached data:', cacheError);
          }
        }
        
        // If no cache or cache failed, propagate the error
        throw error;
      }
      
      // Wait with exponential backoff before retrying
      const delay = RETRY_DELAY * Math.pow(2, attempt);
      console.log(`Retrying in ${delay}ms...`);
      await new Promise(resolve => setTimeout(resolve, delay));
      
      // Retry the request
      return retryWithBackoff(attempt + 1);
    }
  };
  
  return retryWithBackoff();
};

// Usage in component
const CriticalComponent = () => {
  const [data, setData] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [dataSource, setDataSource] = useState(null);
  
  useEffect(() => {
    const fetchCriticalData = async () => {
      try {
        const result = await criticalApiCall('/api/critical-data');
        setData(result.data);
        setDataSource(result.source);
      } catch (error) {
        setError(error);
        // Even in case of complete failure, provide minimal functionality
        setData({ fallbackMode: true, limitedData: true });
      } finally {
        setLoading(false);
      }
    };
    
    fetchCriticalData();
  }, []);
  
  if (loading) return <CriticalLoadingFallback />;
  if (error) return <CriticalErrorFallback error={error} data={data} />;
  
  return (
    <div>
      {dataSource === 'cache' && (
        <div className="stale-data-warning">
          Using cached data - some information may be outdated
        </div>
      )}
      
      {/* Critical UI with graceful degradation if needed */}
      {data.fallbackMode ? (
        <LimitedFunctionalityView data={data} />
      ) : (
        <FullFunctionalityView data={data} />
      )}
    </div>
  );
};
```

### 3. State Recovery Strategy

```typescript
// Implement state recovery system for critical application state
import { useState, useEffect } from 'react';

// Create a recoverable state hook
const useRecoverableState = (key, initialState) => {
  // Try to load state from sessionStorage first
  const getInitialState = () => {
    try {
      const storedState = sessionStorage.getItem(`state_recovery_${key}`);
      if (storedState) {
        return JSON.parse(storedState);
      }
    } catch (error) {
      console.error(`Failed to recover state for ${key}:`, error);
    }
    return typeof initialState === 'function' ? initialState() : initialState;
  };
  
  const [state, setInternalState] = useState(getInitialState);
  
  // Create wrapped setState that persists to sessionStorage
  const setState = (value) => {
    try {
      const newState = typeof value === 'function' ? value(state) : value;
      setInternalState(newState);
      
      // Persist to recovery storage
      sessionStorage.setItem(
        `state_recovery_${key}`, 
        JSON.stringify(newState)
      );
    } catch (error) {
      console.error(`Failed to persist state for ${key}:`, error);
      // Still update the state even if persistence fails
      setInternalState(value);
    }
  };
  
  return [state, setState];
};

// Usage in critical component
const CriticalFormComponent = () => {
  // Use recoverable state for important form data
  const [formData, setFormData] = useRecoverableState('userForm', {
    name: '',
    email: '',
    preferences: []
  });
  
  // Handle form submission with recovery
  const handleSubmit = async (event) => {
    event.preventDefault();
    
    try {
      const result = await criticalApiCall('/api/submit-form', {
        method: 'POST',
        body: JSON.stringify(formData)
      });
      
      // Clear persisted state on successful submission
      sessionStorage.removeItem('state_recovery_userForm');
      
      // Show success UI
    } catch (error) {
      // Form data is still persisted for retry
      // Show error UI with retry option
    }
  };
  
  // Form rendering with recoverable state
};
```

## Root Cause Resolution

After stabilization, implement permanent fixes:

```typescript
// 1. Identify exact issue in component
read_file("[problematic_component_path]", should_read_entire_file=true)

// 2. Implement permanent fix
edit_file("[problematic_component_path]",
          "Fix critical issue with robust implementation",
          "// ... existing imports ...\n\n// Import critical error protections\nimport { ErrorBoundary } from '../components/ErrorBoundary';\n\n// ... existing code ...\n\n// Fixed implementation with robust error handling\n// Previous implementation: [problematic code]\n// New implementation:\n// ... robust implementation code ...")

// 3. Add preventative validation
edit_file("[component_validation_path]",
          "Add preventative validation",
          "// Data validation utility\nexport const validateCriticalData = (data) => {\n  if (!data) return { valid: false, errors: ['Data is required'] };\n  \n  const errors = [];\n  \n  // Required fields validation\n  if (!data.id) errors.push('ID is required');\n  if (!data.name) errors.push('Name is required');\n  \n  // Type validation\n  if (data.count !== undefined && typeof data.count !== 'number') {\n    errors.push('Count must be a number');\n  }\n  \n  // Complex validation\n  if (data.items && !Array.isArray(data.items)) {\n    errors.push('Items must be an array');\n  }\n  \n  return {\n    valid: errors.length === 0,\n    errors\n  };\n};")

// 4. Add monitoring for early detection
edit_file("[monitoring_path]",
          "Implement early warning system",
          "// Early warning monitoring system\nexport const monitorCriticalOperations = () => {\n  // Track API error rates\n  let apiErrorCount = 0;\n  let apiTotalCount = 0;\n  \n  // Override fetch for monitoring\n  const originalFetch = window.fetch;\n  window.fetch = async (...args) => {\n    apiTotalCount++;\n    try {\n      const response = await originalFetch(...args);\n      \n      if (!response.ok) {\n        apiErrorCount++;\n        checkErrorThreshold();\n      }\n      \n      return response;\n    } catch (error) {\n      apiErrorCount++;\n      checkErrorThreshold();\n      throw error;\n    }\n  };\n  \n  // Check if error rate exceeds threshold\n  const checkErrorThreshold = () => {\n    if (apiTotalCount > 10) {\n      const errorRate = apiErrorCount / apiTotalCount;\n      \n      if (errorRate > 0.3) { // 30% error rate\n        console.error(`CRITICAL: API error rate of ${(errorRate * 100).toFixed(1)}% exceeds threshold`);\n        // Log to monitoring service\n        // Potentially activate enhanced fallback mode\n      }\n    }\n  };\n};")
```

