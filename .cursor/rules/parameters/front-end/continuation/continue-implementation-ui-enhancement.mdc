### 3. Accessibility Enhancement Pattern

```typescript
// Accessibility enhancement of a component
import React, { useId } from 'react';
import styles from './Form.module.css';

interface FormFieldProps {
  label: string;
  value: string;
  onChange: (value: string) => void;
  type?: 'text' | 'email' | 'password';
  error?: string;
  required?: boolean;
  autoComplete?: string;
  placeholder?: string;
}

// Enhanced form field with accessibility improvements
export const FormField: React.FC<FormFieldProps> = ({
  label,
  value,
  onChange,
  type = 'text',
  error,
  required = false,
  autoComplete,
  placeholder,
}) => {
  // Generate unique IDs for accessibility
  const id = useId();
  const errorId = `${id}-error`;
  const describedBy = error ? errorId : undefined;
  
  return (
    <div className={styles.fieldContainer}>
      <label 
        htmlFor={id}
        className={styles.label}
      >
        {label}
        {required && <span className={styles.required} aria-hidden="true"> *</span>}
      </label>
      
      <input
        id={id}
        type={type}
        value={value}
        onChange={(e) => onChange(e.target.value)}
        aria-invalid={!!error}
        aria-describedby={describedBy}
        aria-required={required}
        required={required}
        autoComplete={autoComplete}
        placeholder={placeholder}
        className={`${styles.input} ${error ? styles.inputError : ''}`}
      />
      
      {error && (
        <div 
          id={errorId} 
          className={styles.errorMessage}
          role="alert"
        >
          {error}
        </div>
      )}
    </div>
  );
};
```

### 4. Responsive Enhancement Pattern

```typescript
// Responsive enhancement of a component
import React from 'react';
import styles from './Grid.module.css';

interface GridProps {
  children: React.ReactNode;
  columns?: {
    mobile?: number;
    tablet?: number;
    desktop?: number;
  };
  gap?: 'small' | 'medium' | 'large';
}

// Enhanced grid with responsive behavior
export const Grid: React.FC<GridProps> = ({
  children,
  columns = { mobile: 1, tablet: 2, desktop: 4 },
  gap = 'medium',
}) => {
  // Convert columns to CSS custom properties
  const style = {
    '--grid-columns-mobile': columns.mobile?.toString() || '1',
    '--grid-columns-tablet': columns.tablet?.toString() || '2',
    '--grid-columns-desktop': columns.desktop?.toString() || '4',
  } as React.CSSProperties;
  
  return (
    <div 
      className={`${styles.grid} ${styles[`gap-${gap}`]}`}
      style={style}
    >
      {children}
    </div>
  );
};
```

### 5. Animation Enhancement Pattern

```typescript
// Animation enhancement with CSS and React
import React, { useState } from 'react';
import { AnimatePresence, motion } from 'framer-motion';
import styles from './Card.module.css';

interface CardProps {
  title: string;
  content: string;
  onAction?: () => void;
}

// Enhanced card with animations
export const Card: React.FC<CardProps> = ({
  title,
  content,
  onAction,
}) => {
  const [isExpanded, setIsExpanded] = useState(false);
  
  // Animation variants
  const cardVariants = {
    initial: { opacity: 0, y: 20 },
    animate: { opacity: 1, y: 0, transition: { duration: 0.3 } },
    exit: { opacity: 0, scale: 0.95, transition: { duration: 0.2 } },
  };
  
  const contentVariants = {
    collapsed: { height: 0, opacity: 0 },
    expanded: { height: 'auto', opacity: 1, transition: { duration: 0.3 } },
  };
  
  return (
    <motion.div
      className={styles.card}
      variants={cardVariants}
      initial="initial"
      animate="animate"
      exit="exit"
      whileHover={{ scale: 1.02, transition: { duration: 0.2 } }}
    >
      <h3 className={styles.title}>{title}</h3>
      
      <motion.div
        className={styles.content}
        variants={contentVariants}
        animate={isExpanded ? 'expanded' : 'collapsed'}
      >
        <p>{content}</p>
      </motion.div>
      
      <div className={styles.actions}>
        <button 
          onClick={() => setIsExpanded(!isExpanded)}
          className={styles.toggleButton}
          aria-expanded={isExpanded}
        >
          {isExpanded ? 'Show less' : 'Show more'}
        </button>
        
        {onAction && (
          <motion.button
            onClick={onAction}
            className={styles.actionButton}
            whileTap={{ scale: 0.95 }}
          >
            Take action
          </motion.button>
        )}
      </div>
    </motion.div>
  );
};
```

## UI Enhancement Implementation

Apply UI enhancements systematically:

```typescript
// 1. Enhance component styling
read_file("[component_file_path]", should_read_entire_file=true)
edit_file("[component_file_path]",
          "Enhance component with improved UI",
          "// ... existing imports ...\nimport styles from './Component.module.css';\n\n// ... existing code ...\n\n// Enhanced component with improved UI\n// ... implementation code ...")

