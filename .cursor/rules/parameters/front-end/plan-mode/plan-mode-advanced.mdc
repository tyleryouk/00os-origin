  const [state2, setState2] = useState<State2Type>(initialState2);
  
  // Redux state
  const reduxState = useSelector(selectRelevantState);
  const dispatch = useDispatch();
  
  // Derived values
  const derivedValue = useMemo(() => {
    // Computation logic
