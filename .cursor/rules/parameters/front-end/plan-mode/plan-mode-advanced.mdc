    return (
      <div key={item.id}>
        {/* Item rendering */}
      </div>
    );
  }, [relevantDependency]);
  
  // Render
  return (
    <div className="component-container">
      {/* Component JSX */}
      {state1.items.map(renderItem)}
      <button onClick={handleEvent}>Action</button>
    </div>
  );
};
