```typescript
// 1. Create/enhance API error handling utility
edit_file("front-end/src/utils/apiErrorHandling.ts", 
          "Implement API error handling utility",
          "// API error handling utility\n" +
          "import { AxiosError } from 'axios';\n\n" +
          "export interface ApiError {\n" +
          "  status: number;\n" +
          "  message: string;\n" +
          "  code?: string;\n" +
          "  details?: any;\n" +
          "}\n\n" +
          "export function handleApiError(error: unknown): ApiError {\n" +
          "  console.error('API Error:', error);\n" +
          "  \n" +
          "  if (error instanceof AxiosError) {\n" +
          "    const status = error.response?.status || 500;\n" +
          "    const message = error.response?.data?.message || error.message || 'Unknown API error';\n" +
          "    const code = error.response?.data?.code;\n" +
          "    const details = error.response?.data?.details;\n" +
          "    \n" +
          "    return { status, message, code, details };\n" +
          "  }\n" +
          "  \n" +
          "  if (error instanceof Error) {\n" +
          "    return {\n" +
          "      status: 500,\n" +
          "      message: error.message || 'Unknown error',\n" +
          "    };\n" +
          "  }\n" +
          "  \n" +
          "  return {\n" +
          "    status: 500,\n" +
          "    message: 'Unknown error occurred',\n" +
          "  };\n" +
          "}")

