          "Optimize component rendering",
          "// ... existing code ...\n\n// Memoize component to prevent unnecessary re-renders\nconst MemoizedComponent = React.memo(Component);\n\n// ... existing code ...")

// 2. Implement useMemo and useCallback
read_file("front-end/src/components/[component_to_optimize].tsx", should_read_entire_file=true)
edit_file("front-end/src/components/[component_to_optimize].tsx",
          "Implement useMemo and useCallback",
          "// ... existing code ...\n\n// Memoize expensive calculation\nconst expensiveResult = useMemo(() => { return expensiveOperation() }, [dependency]);\n\n// Memoize callback function\nconst handleClick = useCallback(() => { handleOperation() }, [dependency]);\n\n// ... existing code ...")

// 3. Update implementation progress
