### 6. Storybook Documentation Integration

```typescript
// Create or update Storybook stories
edit_file("front-end/src/components/[ComponentName]/[ComponentName].stories.tsx",
          "Create comprehensive Storybook documentation",
          "import React from 'react';
import { Meta, StoryObj } from '@storybook/react';
import { [ComponentName] } from './[ComponentName]';
import type { [ComponentName]Props } from './[ComponentName]';

/**
 * [ComponentName] component documentation
 * 
 * [ComponentName] is a [brief description]
 */
const meta: Meta<typeof [ComponentName]> = {
  title: 'Components/[ComponentName]',
  component: [ComponentName],
  parameters: {
    layout: 'centered',
    docs: {
      description: {
        component: `
[Detailed component description]

## Features
- [Feature 1]
- [Feature 2]
- [Feature 3]

## Usage guidelines
[Usage guidelines and best practices]
        `,
      },
    },
  },
  argTypes: {
    prop1: {
      description: '[Prop1 description]',
      control: { type: 'select' },
      options: ['primary', 'secondary', 'tertiary'],
      table: {
        type: { summary: 'string' },
        defaultValue: { summary: 'primary' },
      },
    },
    prop2: {
      description: '[Prop2 description]',
      control: { type: 'object' },
      table: {
        type: { summary: 'SomeType' },
      },
    },
    onEvent: {
      description: '[onEvent description]',
      action: 'event triggered',
      table: {
        type: { summary: '(event: Event) => void' },
      },
    },
  },
};

export default meta;
type Story = StoryObj<typeof [ComponentName]>;

/**
 * Default [ComponentName] example
 */
export const Default: Story = {
  args: {
    prop1: 'primary',
  },
};

/**
 * Secondary variant example
 */
export const Secondary: Story = {
  args: {
    prop1: 'secondary',
  },
};

/**
 * With event handling example
 */
export const WithEventHandling: Story = {
  args: {
    prop1: 'primary',
    onEvent: (e) => console.log('Event triggered', e),
  },
};

/**
 * Complex configuration example
 */
export const ComplexExample: Story = {
  args: {
    prop1: 'tertiary',
    prop2: { id: 1, name: 'Example' },
  },
  parameters: {
    docs: {
      description: {
        story: 'This example demonstrates a more complex configuration with multiple props.',
      },
    },
  },
};")
```

