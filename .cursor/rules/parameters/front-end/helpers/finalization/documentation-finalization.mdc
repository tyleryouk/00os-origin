### 4. Usage Examples Creation

```typescript
// Create component example file
edit_file("front-end/src/examples/[ComponentName]Example.tsx",
          "Create component usage examples",
          "import React from 'react';
import { [ComponentName] } from 'components/[ComponentName]';

/**
 * Basic [ComponentName] example demonstrating core functionality
 */
export const Basic[ComponentName]Example = () => {
  return (
    <div className=\"example-container\">
      <h3>Basic [ComponentName] Example</h3>
      <[ComponentName]
        prop1=\"primary\"
      />
      <pre>
        {`
<[ComponentName]
  prop1=\"primary\"
/>
        `}
      </pre>
    </div>
  );
};

/**
 * Advanced [ComponentName] example demonstrating additional features
 */
export const Advanced[ComponentName]Example = () => {
  const handleEvent = (event) => {
    console.log('Event handled:', event);
  };

  return (
    <div className=\"example-container\">
      <h3>Advanced [ComponentName] Example</h3>
      <[ComponentName]
        prop1=\"secondary\"
        prop2={{ id: 1, name: 'Example' }}
        onEvent={handleEvent}
      />
      <pre>
        {`
<[ComponentName]
  prop1=\"secondary\"
  prop2={{ id: 1, name: 'Example' }}
  onEvent={handleEvent}
/>
        `}
      </pre>
    </div>
  );
};

/**
 * All [ComponentName] examples grouped
 */
export const [ComponentName]Examples = () => {
  return (
    <div className=\"examples-wrapper\">
      <h2>[ComponentName] Examples</h2>
      <Basic[ComponentName]Example />
      <Advanced[ComponentName]Example />
    </div>
  );
};")
```

