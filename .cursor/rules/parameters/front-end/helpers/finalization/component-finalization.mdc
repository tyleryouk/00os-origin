 *   prop1="value1"
 *   prop2={value2}
 * />
 * ```
 */
// ... existing code ...")
```

#### Props Documentation

```typescript
// Add detailed props documentation
edit_file("front-end/src/components/[ComponentName].tsx",
          "Add detailed props documentation",
