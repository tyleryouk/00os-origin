#### React Hook Errors

```typescript
// 1. Identify hook rule violations
grep_search("Invalid hook call", true, "logs/error.log")

// 2. Fix hook rule violations
edit_file("front-end/src/components/[ComponentName].tsx",
          "Fix React hook rule violations",
          "// ... existing code ...

// ERROR: Invalid hook call. Hooks can only be called inside of the body of a function component.
// FIX: Move hook inside component body
// Before:
// const useOutsideComponent = () => {
//   const [state, setState] = useState(false); // Invalid hook location
//   return state;
// };

// After: Move hooks inside component or create proper custom hook
function useOutsideComponent() {
  const [state, setState] = useState(false); // Valid hook location
  return state;
}

// ERROR: React Hook \"useEffect\" is called conditionally
// FIX: Remove conditional hook call
// Before:
// if (condition) {
//   useEffect(() => { ... }, []); // Invalid conditional hook
// }

// After: Move condition inside hook
useEffect(() => {
  if (condition) {
    // Effect logic
  }
}, [condition]); // Add condition to dependencies

// ... existing code ...")

// 3. Verify hook errors are resolved
run_terminal_cmd("cd front-end && npm run lint", false, false)
run_terminal_cmd("cd front-end && npm run dev", false, true)
```

#### Infinite Re-render Errors

```typescript
// 1. Identify infinite update loops
grep_search("Maximum update depth exceeded", true, "logs/error.log")

// 2. Fix infinite re-render issues
edit_file("front-end/src/components/[ComponentName].tsx",
          "Fix infinite re-render issues",
          "// ... existing code ...

// ERROR: Maximum update depth exceeded
// FIX: Add proper dependency array to useEffect
// Before:
// useEffect(() => {
//   setData(processData(data)); // Causes infinite loop
// }); // Missing dependency array

// After: Add dependency array with proper dependencies
useEffect(() => {
  setData(processData(data));
}, [data]); // Only runs when data changes

// ERROR: Maximum update depth exceeded in state update
// FIX: Fix state update in render
// Before:
// function Component() {
//   const [count, setCount] = useState(0);
//   setCount(count + 1); // Causes infinite loop - updating state during render
//   return <div>{count}</div>;
// }

// After: Move state update to effect or event handler
function Component() {
  const [count, setCount] = useState(0);
  
  // Only update once after mount
  useEffect(() => {
    setCount(prevCount => prevCount + 1);
  }, []);
  
  return <div>{count}</div>;
}

// ... existing code ...")

// 3. Verify infinite loop is resolved
run_terminal_cmd("cd front-end && npm run dev", false, true)
```

#### Memory Leak Errors

```typescript
// 1. Identify memory leak warnings
grep_search("Memory leak.*useEffect", true, "logs/error.log")

// 2. Fix memory leak issues
edit_file("front-end/src/components/[ComponentName].tsx",
          "Fix memory leak issues",
          "// ... existing code ...

// ERROR: Can't perform a React state update on an unmounted component. This is a no-op, but it indicates a memory leak in your application.
// FIX: Add cleanup function to useEffect
// Before:
// useEffect(() => {
//   const subscription = subscribeToData(data => {
//     setData(data); // Potential memory leak if component unmounts
//   });
// }, []);

// After: Add proper cleanup
useEffect(() => {
  let isMounted = true;
  const subscription = subscribeToData(data => {
    if (isMounted) { // Only update state if component is still mounted
      setData(data);
    }
  });
  
  // Return cleanup function
  return () => {
    isMounted = false;
    subscription.unsubscribe();
  };
}, []);

// ... existing code ...")

// 3. Verify memory leak is resolved
run_terminal_cmd("cd front-end && npm run test -- --findRelatedTests src/components/[ComponentName].tsx", false, false)
```

