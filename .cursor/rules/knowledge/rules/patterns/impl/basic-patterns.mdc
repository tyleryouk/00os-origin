async processOrderPayment(order) {
  // Validate order
  if (!order || !order.id) {
    throw new InvalidOrderError('Order is required');
  }

  // Prepare payment details
  const paymentDetails = {
    amount: order.total,
    currency: order.currency || 'USD',
    source: order.paymentSource,
    orderId: order.id
  };

  // Process payment through gateway
  const paymentResult = await this.paymentGateway.processPayment(paymentDetails);
  
  // Update order with payment information
  order.paymentId = paymentResult.paymentId;
  order.paymentStatus = paymentResult.status;
  
  return paymentResult;
}
