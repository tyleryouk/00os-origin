```

#### Header Validation

```bash
# Extract headers
grep -r "^# workflow:" --include="*.md" parameters/rules/ > headers.txt

# Find files missing headers
grep -L "^# workflow:" --include="*.md" parameters/rules/ > missing-headers.txt

# Check header format consistency
python scripts/validate_header_format.py headers.txt
```

#### Reference Validation

```bash
# Find references not wrapped in backticks
grep -r "@parameters/rules/[^`]" --include="*.md" . > unwrapped-refs.txt

# Find references using wrong extension
grep -r "@parameters/rules/.*\.md" --include="*.md" . > wrong-extension-refs.txt

# Check parameter reference consistency
python scripts/validate_parameter_refs.py
```

### Report Generation Patterns

```python
def generate_audit_report(issues):
    """Generate a formatted audit report from collected issues."""
    report = ["# Rules Audit Report - " + datetime.now().strftime("%B %Y")]
    
    # Summary statistics
    total_params = len(issues.get('all_files', []))
    total_issues = sum(len(v) for k, v in issues.items() if k != 'all_files')
    
    report.append("\n## Summary")
    report.append(f"- {total_params} project-rule-parameters audited")
    report.append(f"- {total_issues} issues identified")
    report.append(f"- {len(issues.get('missing_headers', []))} files missing headers")
    report.append(f"- {len(issues.get('format_issues', []))} format inconsistencies")
    
    # Critical issues
    report.append("\n## Critical Issues")
    
    if issues.get('missing_headers'):
        report.append("\n1. Missing headers:")
        for file in issues['missing_headers']:
            report.append(f"   - `{file}` - no header found")
    
    if issues.get('inconsistent_headers'):
        report.append("\n2. Inconsistent headers:")
        component_issues = {}
        for issue in issues['inconsistent_headers']:
            component = issue['component']
            if component not in component_issues:
                component_issues[component] = 0
            component_issues[component] += 1
        
        for component, count in component_issues.items():
            report.append(f"   - {count} headers missing {component} component")
    
    # Format issues
    # ... [additional report sections]
    
    return "\n".join(report)
```

## Examples

### Example Audit Script

```python
#!/usr/bin/env python3
"""
Comprehensive Project-Rule-Parameter Audit Script

This script performs a complete audit of all project-rule-parameters
in the 1000xbrain cognitive architecture.
"""

import os
import re
import sys
import json
from datetime import datetime

def main():
    # Setup phase
    os.makedirs('audit-results', exist_ok=True)
    
    # Inventory phase
    all_files = get_all_parameters()
    headers = extract_headers(all_files)
    refs = extract_references()
    
    # Validation phase
    issues = {}
    issues['all_files'] = all_files
    issues['missing_headers'] = find_missing_headers(all_files, headers)
    issues['inconsistent_headers'] = validate_headers(headers)
    issues['path_issues'] = verify_paths(headers)
    issues['missing_sections'] = verify_sections(all_files)
    issues['reference_issues'] = validate_references(refs)
    
    # Reporting phase
    report = generate_audit_report(issues)
    action_items = generate_action_items(issues)
    
    # Save results
    with open('audit-results/audit-report.md', 'w') as f:
        f.write(report)
    
    with open('audit-results/action-items.md', 'w') as f:
        f.write(action_items)
    
    with open('audit-results/issues.json', 'w') as f:
        json.dump(issues, f, indent=2)
    
    print(f"Audit completed: {len(all_files)} files scanned, {sum(len(v) for k, v in issues.items() if k != 'all_files')} issues found")

if __name__ == "__main__":
    main()
```

### Example Checklist Implementation

```python
def run_checklist(filepath):
    """Run complete checklist for a single project-rule-parameter."""
    results = {
        'filepath': filepath,
        'checks': [],
        'passed': 0,
        'failed': 0
    }
    
    # 1. Check if file exists
    exists = os.path.exists(filepath)
    results['checks'].append({
        'name': 'File exists',
        'passed': exists,
        'details': 'File not found' if not exists else None
    })
    
    if not exists:
        results['failed'] += 1
        return results
    
    # 2. Check for header
    with open(filepath, 'r') as f:
        content = f.read()
        first_line = content.split('\n')[0] if content else ''
        has_header = first_line.startswith('# workflow:')
        results['checks'].append({
            'name': 'Has header',
            'passed': has_header,
            'details': 'Missing header' if not has_header else None
        })
        if has_header:
            results['passed'] += 1
        else:
            results['failed'] += 1
    
    # 3. Check for required sections
    required_sections = [
        '## Purpose',
        '## Command Format',
        '## Required Context',
        '## Process Steps',
        '## Tool Calls',
        '## Expected Outputs',
        '## Error Handling'
    ]
    
    for section in required_sections:
        has_section = section in content
        results['checks'].append({
            'name': f'Has {section}',
            'passed': has_section,
            'details': f'Missing {section}' if not has_section else None
        })
        if has_section:
            results['passed'] += 1
        else:
            results['failed'] += 1
    
    # Additional checks...
    
    return results
```

