### Progressive Context Building

Build context progressively through implementation phases:

```typescript
// 1. Initialize context with core information
const implementationContext = {
  feature: "context-preservation",
  goal: "Implement context tracking across operations",
  components: ["tracking-system", "recovery-mechanism"]
};

// 2. Add analysis context
const analysisContext = {
  ...implementationContext,
  phase: "analysis",
  referenceDocuments: [
    "knowledge/rules/patterns/doc/context-preservation-mechanisms.md",
    "knowledge/rules/guides/implementation-patterns.md"
  ],
  findings: {
    existingPatterns: ["basic-tracking", "reference-chains"],
    gaps: ["recovery-mechanism", "context-validation"]
  }
};

// 3. Add design context
const designContext = {
  ...analysisContext,
  phase: "design",
  approach: "enhanced-tracking-with-recovery",
  designPatterns: ["observer", "memento"],
  validationCriteria: [
    "maintains context across operations", 
    "recovers context after interruption"
  ]
};

// 4. Add implementation context
const implementationContext = {
  ...designContext,
  phase: "implementation",
  implementationFiles: [
    "tracking-system.js",
    "recovery-mechanism.js",
    "context-validation.js"
  ],
  integrationPoints: [
    "system-operations.js", 
    "error-handling.js"
  ]
};
```

