# Common Script Patterns

## Overview

This knowledge file provides common script patterns for the 1000xbrain system. These patterns ensure consistency, efficiency, and reliability across all scripts used within the cognitive architecture.

## File Processing Patterns

### Recursive File Processing

```powershell
function Process-FilesRecursively {
    param (
        [string]$directory,
        [string[]]$includePatterns = @("*.*"),
        [string[]]$excludePatterns = @(),
        [scriptblock]$fileProcessor
    )
    
    # Get all files matching the include patterns
    $files = Get-ChildItem -Path $directory -Recurse -File -Include $includePatterns
    
    # Filter out excluded files
    foreach ($pattern in $excludePatterns) {
        $files = $files | Where-Object { $_.FullName -notlike $pattern }
    }
    
    # Process each file
    foreach ($file in $files) {
        & $fileProcessor $file
    }
}

# Usage example
Process-FilesRecursively -directory "1000xbrain" -includePatterns @("*.md") -excludePatterns @("*\README.md") -fileProcessor {
    param($file)
    # Process each file
    Write-Output "Processing $($file.FullName)"
}
```

### File Pair Processing

```powershell
function Process-FilePairs {
    param (
        [string]$sourceDirectory,
        [string]$targetDirectory,
        [string]$sourcePattern = "*.*",
        [scriptblock]$pairProcessor
    )
    
    # Get all source files
    $sourceFiles = Get-ChildItem -Path $sourceDirectory -Recurse -File -Include $sourcePattern
    
    foreach ($sourceFile in $sourceFiles) {
        # Calculate relative path
        $relativePath = $sourceFile.FullName.Substring($sourceDirectory.Length)
        if ($relativePath.StartsWith("\")) {
            $relativePath = $relativePath.Substring(1)
        }
        
        # Calculate target path
        $targetPath = Join-Path -Path $targetDirectory -ChildPath $relativePath
        
        # Process the file pair
        & $pairProcessor $sourceFile.FullName $targetPath
    }
}

# Usage example
Process-FilePairs -sourceDirectory "1000xbrain" -targetDirectory ".cursor\rules" -sourcePattern "*.md" -pairProcessor {
    param($sourcePath, $targetPath)
    Write-Output "Source: $sourcePath -> Target: $targetPath"
}
```

## Error Handling Patterns

### Robust Error Handling

```powershell
function Execute-WithErrorHandling {
    param (
        [string]$operationName,
        [scriptblock]$operation,
        [scriptblock]$errorHandler,
        [scriptblock]$finallyBlock
    )
    
    try {
        Write-Verbose "Starting operation: $operationName"
        & $operation
        Write-Verbose "Completed operation: $operationName"
    }
    catch {
        Write-Error "Error in operation '$operationName': $_"
        if ($null -ne $errorHandler) {
            & $errorHandler $_
        }
        else {
            throw
        }
    }
    finally {
        if ($null -ne $finallyBlock) {
            & $finallyBlock
        }
    }
}

# Usage example
Execute-WithErrorHandling -operationName "File Processing" -operation {
    # Main operation
    Get-Content -Path "nonexistent.txt"
} -errorHandler {
    param($error)
    Write-Warning "Handled error: $error"
} -finallyBlock {
    # Cleanup resources
    Write-Verbose "Cleaning up resources..."
}
```

### Validation Pattern

```powershell
function Validate-Input {
    param (
        [PSObject]$input,
        [hashtable]$validationRules
    )
    
    $validationErrors = @()
    
    foreach ($key in $validationRules.Keys) {
        $rule = $validationRules[$key]
        $value = $input.$key
        
        if ($null -eq $value -and $rule.required) {
            $validationErrors += "Missing required field: $key"
            continue
        }
        
        if ($null -ne $value -and $rule.pattern -and $value -notmatch $rule.pattern) {
            $validationErrors += "Invalid format for field '$key': Expected pattern $($rule.pattern)"
        }
        
        if ($null -ne $rule.validator) {
            $customResult = & $rule.validator $value
            if (-not $customResult.valid) {
                $validationErrors += $customResult.message
            }
        }
    }
    
    return @{
        valid = ($validationErrors.Count -eq 0)
        errors = $validationErrors
    }
}

# Usage example
$inputData = @{
    name = "example.md"
    path = "1000xbrain/core"
}

$rules = @{
    name = @{
        required = $true
        pattern = "^[a-z0-9-]+\.md$"
    }
    path = @{
        required = $true
        validator = {
            param($path)
            $valid = Test-Path $path
            return @{
                valid = $valid
                message = if (-not $valid) { "Path does not exist: $path" } else { $null }
            }
        }
    }
}

$result = Validate-Input -input $inputData -validationRules $rules
if (-not $result.valid) {
    Write-Error "Validation failed:`n- $($result.errors -join "`n- ")"
}
```

## Logging Patterns

### Structured Logging

```powershell
function Write-StructuredLog {
    param (
        [string]$level,
        [string]$message,
        [string]$component,
        [hashtable]$data = @{},
        [string]$logFilePath
    )
    
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    
    $logEntry = @{
        timestamp = $timestamp
        level = $level
        component = $component
        message = $message
    }
    
    foreach ($key in $data.Keys) {
        $logEntry[$key] = $data[$key]
    }
    
    $jsonEntry = $logEntry | ConvertTo-Json -Compress
    
    if ($logFilePath) {
        Add-Content -Path $logFilePath -Value $jsonEntry
    }
    
    switch ($level) {
        "ERROR" {
            Write-Error $message
        }
        "WARNING" {
            Write-Warning $message
        }
        "INFO" {
            Write-Information $message
        }
        "DEBUG" {
            Write-Verbose $message
        }
        default {
            Write-Output $message
        }
    }
    
    return $logEntry
}

# Usage example
Write-StructuredLog -level "INFO" -component "FileSynchronizer" -message "Starting file synchronization" -data @{
    sourceDirectory = "1000xbrain"
    targetDirectory = ".cursor/rules"
} -logFilePath "logs/sync.log"
```

### Log Rotation

```powershell
function Get-RotatedLogPath {
    param (
        [string]$logDirectory,
        [string]$logNamePrefix,
        [int]$maxLogFiles = 5
    )
    
    # Ensure log directory exists
    if (-not (Test-Path $logDirectory)) {
        New-Item -Path $logDirectory -ItemType Directory -Force | Out-Null
    }
    
    # Current log file name based on date
    $currentLogFile = Join-Path -Path $logDirectory -ChildPath "$logNamePrefix-$(Get-Date -Format 'yyyy-MM-dd').log"
    
    # Clean up old log files if exceeding max count
    $logFiles = Get-ChildItem -Path $logDirectory -Filter "$logNamePrefix-*.log" | Sort-Object LastWriteTime -Descending
    
    if ($logFiles.Count -gt $maxLogFiles) {
        $filesToRemove = $logFiles | Select-Object -Skip $maxLogFiles
        foreach ($file in $filesToRemove) {
            Remove-Item -Path $file.FullName -Force
            Write-Verbose "Removed old log file: $($file.FullName)"
        }
    }
    
    return $currentLogFile
}

# Usage example
$logPath = Get-RotatedLogPath -logDirectory "logs" -logNamePrefix "sync" -maxLogFiles 7
Write-Output "Using log file: $logPath"
```

## Configuration Patterns

### Configuration Loading

```powershell
function Load-Configuration {
    param (
        [string]$configPath,
        [hashtable]$defaultConfig = @{}
    )
    
    $config = $defaultConfig.Clone()
    
    if (Test-Path $configPath) {
        try {
            $loadedConfig = Get-Content -Path $configPath -Raw | ConvertFrom-Json -AsHashtable
            foreach ($key in $loadedConfig.Keys) {
                $config[$key] = $loadedConfig[$key]
            }
        }
        catch {
            Write-Error "Error loading configuration from $configPath: $_"
        }
    }
    else {
        Write-Warning "Configuration file not found at $configPath. Using default configuration."
    }
    
    return $config
}

# Usage example
$defaultConfig = @{
    sourceDirectory = "1000xbrain"
    targetDirectory = ".cursor/rules"
    excludePatterns = @("*\README.md")
    logLevel = "INFO"
}

$config = Load-Configuration -configPath "config.json" -defaultConfig $defaultConfig
Write-Output "Loaded configuration: $($config | ConvertTo-Json -Compress)"
```

## Progress Reporting Patterns

### Progress Tracking

```powershell
function Process-ItemsWithProgress {
    param (
        [array]$items,
        [scriptblock]$processor,
        [string]$activity = "Processing items"
    )
    
    $totalItems = $items.Count
    $currentItem = 0
    
    foreach ($item in $items) {
        $currentItem++
        $percentComplete = [math]::Floor(($currentItem / $totalItems) * 100)
        
        Write-Progress -Activity $activity -Status "Processing item $currentItem of $totalItems" -PercentComplete $percentComplete -CurrentOperation $item
        
        & $processor $item
    }
    
    Write-Progress -Activity $activity -Completed
}

# Usage example
$files = Get-ChildItem -Path "1000xbrain" -Recurse -File -Include "*.md"
Process-ItemsWithProgress -items $files -activity "Processing markdown files" -processor {
    param($file)
    Write-Output "Processing $($file.Name)"
    Start-Sleep -Milliseconds 100  # Simulate processing time
}
```

