## Context Preservation System

### When to Use

Use context preservation when:
- Working with files split across multiple chunks
- Needing to maintain semantic relationships between sections
- Implementing complex features that span multiple files
- Tracking dependencies across system components

### Implementation Approaches

#### Basic Context Preservation

```typescript
// Add context headers to file chunks
function addContextHeaders(chunk: string, context: Context): string {
  return `
--- SECTION CONTEXT ---
Previous: ${context.previous}
Current: ${context.current}
Next: ${context.next}

${chunk}
`;
}

// Read with context preservation
async function readWithContext(file: string): Promise<string> {
  const strategy = checkFileSize(file);
  
  if (strategy.strategy === 'whole_file') {
    return read_file(file, should_read_entire_file=true);
  } else {
    // Multi-chunk reading with context
    const chunks = [];
    let prevChunk = '';
    
    for (const chunk of strategy.params) {
      const content = await read_file(file, chunk.offset, chunk.limit);
      
      // Add context information
      const context = {
        previous: summarize(prevChunk),
        current: `Lines ${chunk.offset}-${chunk.offset + chunk.limit}`,
        next: chunk === strategy.params[strategy.params.length - 1] ? 
              'End of file' : `Next ${strategy.params[chunk + 1].limit} lines`
      };
      
      chunks.push(addContextHeaders(content, context));
      prevChunk = content;
    }
    
    return chunks.join('\n\n');
  }
}
```

#### Advanced Context Tracking

```typescript
class ContextTracker {
  private contexts: Map<string, Context> = new Map();
  
  trackContext(file: string, context: Context): void {
    this.contexts.set(file, context);
  }
  
  getContext(file: string): Context | undefined {
    return this.contexts.get(file);
  }
  
  updateContext(file: string, updates: Partial<Context>): void {
    const current = this.contexts.get(file) || {};
    this.contexts.set(file, { ...current, ...updates });
  }
}

// Implementation with context tracking
async function implementWithContextTracking(files: string[]): Promise<void> {
  const tracker = new ContextTracker();
  
  for (const file of files) {
    const content = await readWithStrategy(file);
    const context = extractContext(content);
    tracker.trackContext(file, context);
    
    // Implement changes with context awareness
    // ...implementation code...
    
    // Update context after changes
    tracker.updateContext(file, { status: 'modified' });
  }
}
```

