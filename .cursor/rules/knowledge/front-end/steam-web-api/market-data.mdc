## Market Data Visualization Components

### Market Overview Panel

```tsx
import React, { useState } from 'react';
import { 
  Box, 
  Card, 
  CardContent, 
  Typography, 
  Tab, 
  Tabs, 
  CircularProgress,
  Button
} from '@mui/material';
import RefreshIcon from '@mui/icons-material/Refresh';
import PriceHistoryChart from 'components/market/PriceHistoryChart';
import MarketPrice from 'components/market/MarketPrice';
import { useItemPrice, usePriceHistory } from 'hooks/useMarketData';
import { formatCurrency } from 'utils/formatters';

interface MarketOverviewProps {
  itemName: string;
}

const MarketOverview: React.FC<MarketOverviewProps> = ({ itemName }) => {
  const [timeRange, setTimeRange] = useState<'24h' | '7d' | '30d' | '90d' | 'all'>('7d');
  const { priceData, loading: priceLoading, refreshPrice } = useItemPrice(itemName);
  const { historyData, loading: historyLoading, refreshHistory } = usePriceHistory(itemName, timeRange);
  
  const handleTimeRangeChange = (_: React.SyntheticEvent, newValue: '24h' | '7d' | '30d' | '90d' | 'all') => {
    setTimeRange(newValue);
  };
  
  const handleRefresh = () => {
    refreshPrice();
    refreshHistory();
  };
  
  const loading = priceLoading || historyLoading;
  
  return (
    <Card>
      <CardContent>
        <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
          <Typography variant="h6">Market Overview</Typography>
          <Button 
            size="small" 
            startIcon={<RefreshIcon />} 
            onClick={handleRefresh}
            disabled={loading}
          >
            Refresh
          </Button>
        </Box>
        
        {loading ? (
          <Box sx={{ display: 'flex', justifyContent: 'center', py: 4 }}>
            <CircularProgress />
          </Box>
        ) : priceData ? (
          <>
            <Box sx={{ display: 'flex', justifyContent: 'space-between', mb: 3 }}>
              <Box>
                <Typography variant="body2" color="text.secondary">Current Price</Typography>
                <MarketPrice 
                  currentPrice={priceData.currentPrice}
                  previousPrice={priceData.previousPrice}
                  size="large"
                />
              </Box>
              
              <Box>
                <Typography variant="body2" color="text.secondary">24h Volume</Typography>
                <Typography variant="h6">{priceData.volume.toLocaleString()}</Typography>
              </Box>
              
              <Box>
                <Typography variant="body2" color="text.secondary">24h Range</Typography>
                <Typography variant="body1">
                  {formatCurrency(priceData.lowestPrice)} - {formatCurrency(priceData.highestPrice)}
                </Typography>
              </Box>
            </Box>
            
            <Box sx={{ mb: 2 }}>
              <Tabs 
                value={timeRange}
                onChange={handleTimeRangeChange}
                variant="fullWidth"
              >
                <Tab label="24H" value="24h" />
                <Tab label="7D" value="7d" />
                <Tab label="30D" value="30d" />
                <Tab label="90D" value="90d" />
                <Tab label="All" value="all" />
              </Tabs>
            </Box>
            
            <PriceHistoryChart 
              data={historyData}
              timeRange={timeRange}
              height={300}
            />
          </>
        ) : (
          <Typography color="text.secondary">No price data available</Typography>
        )}
      </CardContent>
    </Card>
  );
};

export default MarketOverview;
```

### Market Listings Table

```tsx
import React, { useState } from 'react';
import {
  Box,
  Table,
  TableBody,
  TableCell,
  TableContainer,
  TableHead,
  TableRow,
  Paper,
  Typography,
  Pagination,
  CircularProgress,
  Button
} from '@mui/material';
import { useMarketListings } from 'hooks/useMarketData';
import { formatCurrency, formatDate } from 'utils/formatters';

interface MarketListingsTableProps {
  itemName: string;
  pageSize?: number;
}

const MarketListingsTable: React.FC<MarketListingsTableProps> = ({ 
  itemName,
  pageSize = 10
}) => {
  const [page, setPage] = useState(1);
  const { listings, total, loading, refreshListings } = useMarketListings(
    itemName,
    page,
    pageSize
  );
  
  const handlePageChange = (_: React.ChangeEvent<unknown>, value: number) => {
    setPage(value);
  };
  
  const totalPages = Math.ceil(total / pageSize);
  
  return (
    <Box>
      <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', mb: 2 }}>
        <Typography variant="h6">Market Listings</Typography>
        <Button 
          size="small" 
          onClick={() => refreshListings()}
          disabled={loading}
        >
          Refresh
        </Button>
      </Box>
      
      {loading ? (
        <Box sx={{ display: 'flex', justifyContent: 'center', py: 4 }}>
          <CircularProgress />
        </Box>
      ) : listings.length > 0 ? (
        <>
          <TableContainer component={Paper} sx={{ mb: 2 }}>
            <Table size="small">
              <TableHead>
                <TableRow>
                  <TableCell>Seller</TableCell>
                  <TableCell align="right">Price</TableCell>
                  <TableCell align="center">Wear</TableCell>
                  <TableCell align="center">Pattern</TableCell>
                  <TableCell align="right">Listed</TableCell>
                  <TableCell align="right">Actions</TableCell>
                </TableRow>
              </TableHead>
              <TableBody>
                {listings.map((listing) => (
                  <TableRow key={listing.listingId}>
                    <TableCell>
                      <Typography variant="body2" noWrap sx={{ maxWidth: 150 }}>
                        {listing.seller.displayName}
                      </Typography>
                    </TableCell>
                    <TableCell align="right">
                      <Typography fontWeight="bold">
                        {formatCurrency(listing.price)}
                      </Typography>
                    </TableCell>
                    <TableCell align="center">
                      {listing.wear ? listing.wear.toFixed(4) : 'N/A'}
                    </TableCell>
                    <TableCell align="center">
                      {listing.patternId || 'N/A'}
                    </TableCell>
                    <TableCell align="right">
                      {formatDate(listing.listedAt, { relative: true })}
                    </TableCell>
                    <TableCell align="right">
                      <Button size="small" variant="contained" color="primary">
                        Buy
                      </Button>
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </TableContainer>
          
          <Box sx={{ display: 'flex', justifyContent: 'center' }}>
            <Pagination 
              count={totalPages} 
              page={page} 
              onChange={handlePageChange} 
              color="primary" 
            />
          </Box>
        </>
      ) : (
        <Typography color="text.secondary" sx={{ py: 4, textAlign: 'center' }}>
          No market listings available for this item
        </Typography>
      )}
    </Box>
  );
};

export default MarketListingsTable;
```

## Error Handling Patterns

1. **API Failure Handling**:
   - Implement fallback UI for market data components
   - Show appropriate loading states during data fetching
   - Display user-friendly error messages
   - Provide retry mechanisms for failed requests

2. **Network Issues**:
   - Cache market data for offline access
   - Implement stale-while-revalidate pattern
   - Show cached data with freshness indicator
   - Queue data refreshes when connection is restored

3. **Data Inconsistency Handling**:
   - Validate data integrity before display
   - Handle missing or incomplete data gracefully
   - Implement fallback display options
   - Show data freshness indicators

## Best Practices

1. **Performance Optimization**:
   - Implement appropriate caching strategies
   - Use virtualization for long market listing tables
   - Lazy-load market data components
   - Optimize chart rendering for performance

2. **User Experience**:
   - Show loading states during data fetching
   - Provide clear price trend indicators
   - Implement responsive chart designs
   - Maintain UI consistency across market components

3. **Data Freshness**:
   - Display last update timestamps
   - Provide manual refresh options
   - Implement auto-refresh for critical data
   - Show data staleness indicators when appropriate

