# Process: system-monitor

## Metadata
- Description: Monitor system resources and component status
- Category: tools
- Permissions: [basic, system-read]
- Author: 00reaper
- Version: 1.0.0

## Input
- component: Optional component to monitor (commands, state, processes)
- detailed: Flag to show detailed output

## Output
- Formatted system monitoring information

## Execution
```javascript
// Main execution function
async function execute() {
  try {
    // Get component to monitor (default to 'overview')
    const component = inputs.component ? inputs.component.toLowerCase() : 'overview';
    const detailed = inputs.detailed === true;
    
    // Execute monitoring based on requested component
    switch (component) {
      case 'commands':
        return await monitorCommands(detailed);
      case 'state':
        return await monitorState(detailed);
      case 'processes':
        return await monitorProcesses(detailed);
      case 'overview':
      default:
        return await monitorOverview(detailed);
    }
  } catch (error) {
    return formatError(`Error monitoring system: ${error.message}`, [
      'Try specifying a different component',
      'Use --detailed for more information',
      'Check system permissions'
    ]);
  }
}

// Monitor overall system status
async function monitorOverview(detailed) {
  try {
    // Collect status information from all components
    const commandStatus = await getCommandStats();
    const stateStatus = await getStateStats();
    const processStatus = await getProcessStats();
    
    // Format timestamp
    const timestamp = new Date().toISOString();
    
    // Build overview output
    let output = `✅ System Status Overview (${formatTime(timestamp)})\n\n`;
    
    // Basic stats section
    output += `System Components:\n`;
    output += `-----------------\n`;
    output += `Commands: ${commandStatus.total} registered (${commandStatus.categories.length} categories)\n`;
    output += `State: ${stateStatus.keys} keys (${formatBytes(stateStatus.size)})\n`;
    output += `Processes: ${processStatus.active} active / ${processStatus.total} total\n\n`;
    
    // Add system uptime (simulated)
    const uptime = simulateUptime();
    output += `System Uptime: ${formatDuration(uptime)}\n\n`;
    
    // Resource usage (simulated)
    const resources = simulateResourceUsage();
    output += `Resource Usage:\n`;
    output += `--------------\n`;
    output += `Memory: ${resources.memory.used}/${resources.memory.total} (${resources.memory.percentage}%)\n`;
    output += `Storage: ${resources.storage.used}/${resources.storage.total} (${resources.storage.percentage}%)\n`;
    output += `Tool Calls: ${resources.toolCalls.used}/${resources.toolCalls.total} (${resources.toolCalls.percentage}%)\n\n`;
    
    if (detailed) {
      // Add detailed component information for each section
      output += `Component Details:\n`;
      output += `-----------------\n\n`;
      
      // Command details
      output += `Commands by Category:\n`;
      for (const category in commandStatus.categoryCounts) {
        output += `- ${category}: ${commandStatus.categoryCounts[category]} commands\n`;
      }
      output += `\n`;
      
      // State details
      output += `State by Scope:\n`;
      for (const scope in stateStatus.scopes) {
        output += `- ${scope}: ${stateStatus.scopes[scope].keys} keys (${formatBytes(stateStatus.scopes[scope].size)})\n`;
      }
      output += `\n`;
      
      // Process details
      output += `Recent Process Activity:\n`;
      processStatus.recent.forEach((proc, index) => {
        output += `- ${proc.name} (${formatTime(proc.startTime)}, ${proc.duration}ms)\n`;
      });
      output += `\n`;
      
      // Add health checks
      const health = simulateHealthChecks();
      output += `System Health Checks:\n`;
      for (const check in health) {
        const status = health[check].status;
        const icon = status === 'healthy' ? '✅' : (status === 'warning' ? '⚠️' : '❌');
        output += `${icon} ${check}: ${health[check].message}\n`;
      }
    } else {
      // Add instructions for detailed view
      output += `For detailed information, use: system-monitor --detailed\n`;
      output += `For specific components, use: system-monitor [commands|state|processes]\n`;
    }
    
    return output;
  } catch (error) {
    return formatError(`Error generating overview: ${error.message}`);
  }
}

// Monitor command registry
async function monitorCommands(detailed) {
  try {
    // Get command stats
    const stats = await getCommandStats();
    
    let output = `✅ Command Registry Status\n\n`;
    
    output += `Total Commands: ${stats.total}\n`;
    output += `Categories: ${stats.categories.length} (${stats.categories.join(', ')})\n\n`;
    
    output += `Command Counts by Category:\n`;
    output += `---------------------------\n`;
    for (const category in stats.categoryCounts) {
      output += `${category}: ${stats.categoryCounts[category]}\n`;
    }
    
    if (detailed) {
      output += `\nCommand Listing:\n`;
      output += `---------------\n`;
      
      // Group commands by category
      for (const category in stats.commandsByCategory) {
        output += `\n${category}:\n`;
        stats.commandsByCategory[category].forEach(cmd => {
          output += `- ${cmd.name}: ${cmd.description}\n`;
        });
      }
    }
    
    return output;
  } catch (error) {
    return formatError(`Error monitoring commands: ${error.message}`);
  }
}

// Monitor state system
async function monitorState(detailed) {
  try {
    // Get state stats
    const stats = await getStateStats();
    
    let output = `✅ State Manager Status\n\n`;
    
    output += `Total Keys: ${stats.keys}\n`;
    output += `Total Size: ${formatBytes(stats.size)}\n\n`;
    
    output += `State by Scope:\n`;
    output += `--------------\n`;
    for (const scope in stats.scopes) {
      output += `${scope}: ${stats.scopes[scope].keys} keys (${formatBytes(stats.scopes[scope].size)})\n`;
    }
    
    if (detailed) {
      output += `\nKey Distribution:\n`;
      output += `----------------\n`;
      
      // Add key distribution by namespace
      for (const namespace in stats.namespaces) {
        output += `${namespace}: ${stats.namespaces[namespace]} keys\n`;
      }
      
      output += `\nRecent Activity:\n`;
      output += `--------------\n`;
      
      // Add simulated recent activity
      const recentActivity = simulateStateActivity();
      recentActivity.forEach(activity => {
        const icon = activity.operation === 'set' ? '➕' : (activity.operation === 'get' ? '🔍' : '➖');
        output += `${icon} ${activity.operation} ${activity.key} (${activity.scope}, ${formatTime(activity.timestamp)})\n`;
      });
    }
    
    return output;
  } catch (error) {
    return formatError(`Error monitoring state: ${error.message}`);
  }
}

// Monitor processes
async function monitorProcesses(detailed) {
  try {
    // Get process stats
    const stats = await getProcessStats();
    
    let output = `✅ Process Execution Status\n\n`;
    
    output += `Active Processes: ${stats.active}\n`;
    output += `Total Executed: ${stats.total}\n`;
    output += `Average Duration: ${stats.averageDuration}ms\n\n`;
    
    output += `Recent Process Executions:\n`;
    output += `-------------------------\n`;
    stats.recent.forEach((proc, index) => {
      output += `${index+1}. ${proc.name} (${formatTime(proc.startTime)}, ${proc.duration}ms, ${proc.status})\n`;
    });
    
    if (detailed) {
      output += `\nProcess Execution Times:\n`;
      output += `----------------------\n`;
      
      // Add process execution times by category
      for (const category in stats.executionTimes) {
        output += `\n${category}:\n`;
        for (const proc in stats.executionTimes[category]) {
          const times = stats.executionTimes[category][proc];
          output += `- ${proc}: Avg ${times.avg}ms, Min ${times.min}ms, Max ${times.max}ms\n`;
        }
      }
      
      output += `\nError Distribution:\n`;
      output += `------------------\n`;
      for (const errorType in stats.errors) {
        output += `${errorType}: ${stats.errors[errorType]} occurrences\n`;
      }
    }
    
    return output;
  } catch (error) {
    return formatError(`Error monitoring processes: ${error.message}`);
  }
}

