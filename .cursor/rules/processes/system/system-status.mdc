### Component-Specific Status

When specific components are requested (`> system status --components=parser,executor`), the process will only display information about those components:

```
✅ 00OS System Status (Components: parser, executor)

SYSTEM INFORMATION:
  - Version: 1.0.0
  - Active Identity: 00reaper

COMPONENT STATUS:
  ✅ Parser (v1.2.1)
    - Commands Processed: 152
    - Processing Time Avg: 12ms
  
  ✅ Executor (v1.3.2)
    - Processes Executed: 89
    - Success Rate: 98.9%
```

### Error Handling

#### Component Not Found
```
❌ Error: Component 'invalid' not found.

Available components:
- parser
- registry
- executor
- permissions

Use '> system status' to check all components.
```

#### Permission Error
```
❌ Error: Insufficient permissions to access detailed system information.

You need system.admin permission to view detailed status.
Use 'identity permissions request system.admin' to request access.
```

### Implementation Logic

```javascript
// Dynamic system status reporter
async function execute() {
  try {
    // Initialize status data
    const statusData = {
      system: {
        name: tools.getSystemSetting('system.name') || '00OS',
        version: tools.getSystemSetting('system.version') || '0.1.0',
        status: 'Operational'
      },
      components: await checkComponentStatus(),
      identity: getCurrentIdentity(),
      workingDirectory: getCurrentDirectory(),
      processes: await getActiveProcesses(),
      commands: await getLoadedCommands(),
      recentCommands: await getRecentCommands(),
      health: 'Good',
      uptime: 'Session active'
    };
    
    // Format and return status report
    return formatStatusReport(statusData);
  } catch (error) {
    return formatError(`Error retrieving system status: ${error.message}`, 'STATUS_ERROR');
  }
}

// Dynamically check component status 
async function checkComponentStatus() {
  const components = [
    { name: 'Command Parser', path: '00OS/core/parser.md' },
    { name: 'Process Registry', path: '00OS/core/registry.md' },
    { name: 'Executor', path: '00OS/core/executor.md' },
    { name: 'Permissions', path: '00OS/core/permissions.md' },
    { name: 'State Manager', path: '00OS/core/state-manager.md' },
    { name: 'Command Handler', path: '00OS/core/command-handler.md' },
    { name: '00OS Integration', path: '00OS/core/00os-integration.md' },
    { name: 'Setup Script', path: '00OS/core/setup-script.md' }
  ];
  
  const componentStatus = {};
  
  try {
    // Check each component file existence
    for (const component of components) {
      try {
        // Check if file exists
        const fileExists = await tools.call('list_dir', { 
          relative_workspace_path: component.path,
          explanation: `Checking if component file ${component.path} exists`
        });
        
        componentStatus[component.name] = fileExists ? 'Active' : 'Unavailable';
      } catch (error) {
        componentStatus[component.name] = 'Unknown';
      }
    }
  } catch (error) {
    // Default to basic status if dynamic check fails
    for (const component of components) {
      componentStatus[component.name] = 'Assumed Active';
    }
  }
  
  return componentStatus;
}

// Get current identity
function getCurrentIdentity() {
  return tools.getSystemSetting('identity.default') || '00reaper (System Administrator)';
}

// Get current directory
function getCurrentDirectory() {
  return tools.state.get('currentDirectory', 'system') || '/';
}

// Get active processes
async function getActiveProcesses() {
  try {
    // In a real implementation, this would check actual running processes
    // For now, just count system-status as running
    return { count: 1, active: ['system-status'] };
  } catch (error) {
    return { count: 0, active: [] };
  }
}

// Count loaded commands by checking directories
async function getLoadedCommands() {
  let count = 0;
  try {
    // Check process directories for command files
    const directories = [
      '00OS/processes/system/',
      '00OS/processes/tools/',
      '00OS/processes/examples/'
    ];
    
    for (const dir of directories) {
      try {
        const result = await tools.call('list_dir', { 
          relative_workspace_path: dir,
          explanation: `Counting command files in ${dir}`
        });
        
        if (result && result.entries) {
          // Count .md files as commands
          count += result.entries.filter(entry => 
            !entry.is_directory && entry.path.endsWith('.md')
          ).length;
        }
      } catch (error) {
        // Continue with next directory if one fails
        continue;
      }
    }
    
    return { count };
  } catch (error) {
    // Return default if dynamic check fails
    return { count: 8 };
  }
}

// Get recent commands from state
async function getRecentCommands() {
  try {
    const recentCommands = tools.state.get('recentCommands', 'system') || [];
    return {
      count: recentCommands.length,
      commands: recentCommands.slice(-3) // Last 3 commands
    };
  } catch (error) {
    // Return default if state access fails
    return { count: 1, commands: ['help'] };
  }
}

// Format the status report
function formatStatusReport(data) {
  let output = `✅ 00OS System Status\n\n`;
  
  // System information section
  output += `System Information:\n`;
  output += `-----------------\n`;
  output += `Name:           ${data.system.name}\n`;
  output += `Version:        ${data.system.version}\n`;
  output += `Status:         ${data.system.status}\n\n`;
  
  // Component status section
  output += `Component Status:\n`;
  output += `-----------------\n`;
  for (const [name, status] of Object.entries(data.components)) {
    const statusIcon = status === 'Active' ? '✅' : (status === 'Unavailable' ? '❌' : '⚠️');
    output += `${name}:  ${statusIcon} ${status}\n`;
  }
  output += `\n`;
  
  // Additional system information
  output += `Identity:        ${data.identity}\n`;
  output += `Working Directory: ${data.workingDirectory}\n\n`;
  
  // Process and command information
  output += `Active Processes: ${data.processes.count}`;
  if (data.processes.active && data.processes.active.length > 0) {
    output += ` (${data.processes.active.join(', ')})`;
  }
  output += `\n`;
  
  output += `Loaded Commands:  ${data.commands.count}\n`;
  
  output += `Recent Commands:  ${data.recentCommands.count}`;
  if (data.recentCommands.commands && data.recentCommands.commands.length > 0) {
    output += ` (${data.recentCommands.commands.join(', ')})`;
  }
  output += `\n\n`;
  
  // System health
  output += `System Health:    ${data.health}\n`;
  output += `Uptime:           ${data.uptime}\n`;
  
  return output;
}

// Format error message
function formatError(message, code, suggestions = []) {
  let output = `❌ Error [${code}]: ${message}\n\n`;
  
  if (suggestions.length > 0) {
    output += "Suggestions:\n";
    for (const suggestion of suggestions) {
      output += `- ${suggestion}\n`;
    }
  }
  
  return output;
}

// Execute and return result
execute();
```

### Helper Functions

The process relies on these helper functions:

1. `getSystemInfo()`: Retrieves basic system information
2. `getComponentStatus(component)`: Gets the status of a specific component
3. `getProcessStats()`: Retrieves process statistics
4. `getSystemEvents()`: Gets recent system events
5. `getSystemConfig()`: Retrieves system configuration
6. `isValidComponent(component)`: Verifies if a component exists
7. `hasPermission(permission)`: Checks if the user has the required permission

### Integration with 00OS

This process integrates with core system components to gather status information and present a unified view of the system's health and activity. It serves as both a diagnostic tool and a system monitor for 00OS. 