# Process: chain

## Metadata
- Description: Execute multiple commands in sequence
- Category: system
- Permissions: [basic, execution]
- Author: 00reaper
- Version: 1.0.0

## Input
- commands: String containing multiple commands separated by '|' or ';'
- verbose: Flag to show detailed execution information

## Output
- Array of results from each command execution

## Execution
```javascript
// Main execution function
async function execute() {
  try {
    // Check if commands are provided
    if (!inputs.commands) {
      return formatError('No commands provided', [
        'Specify multiple commands separated by "|" or ";"',
        'Example: chain echo Hello | echo World'
      ]);
    }

    // Parse command string into separate commands
    const separator = inputs.commands.includes('|') ? '|' : ';';
    const commands = inputs.commands.split(separator).map(cmd => cmd.trim());
    
    if (commands.length < 2) {
      return formatError('Chain requires at least two commands', [
        'Use the chain command to execute multiple commands in sequence',
        'Example: chain echo Hello | echo World'
      ]);
    }

    // Execute each command in sequence
    const results = [];
    const verbose = inputs.verbose === true;
    
    for (let i = 0; i < commands.length; i++) {
      const cmd = commands[i];
      if (!cmd) continue;
      
      try {
        // Log execution if verbose
        if (verbose) {
          tools.log(`Executing command ${i+1}/${commands.length}: ${cmd}`);
        }
        
        // Execute the command by fetching and running the appropriate process
        const commandParts = parseCommand(cmd);
        const result = await executeCommand(commandParts.command, commandParts.args);
        
        // Store result
        results.push({
          command: cmd,
          success: result.success !== false,
          result: result
        });
        
        // Log result if verbose
        if (verbose) {
          tools.log(`Command ${i+1} result: ${result.success ? 'Success' : 'Failure'}`);
        }
      } catch (cmdError) {
        // Handle command execution error
        results.push({
          command: cmd,
          success: false,
          error: cmdError.message
        });
        
        // Log error if verbose
        if (verbose) {
          tools.log(`Command ${i+1} error: ${cmdError.message}`);
        }
      }
    }
    
    // Format the final response
    return formatChainResults(commands, results, verbose);
  } catch (error) {
    // Handle general execution error
    return formatError(`Error executing command chain: ${error.message}`, [
      'Check the syntax of your commands',
      'Ensure each command is properly formatted',
      'Try running commands individually first'
    ]);
  }
}

// Parse a command string into command and arguments
function parseCommand(commandStr) {
  // Remove leading '>' if present (user might include it by habit)
  const cleanCommand = commandStr.startsWith('>') 
    ? commandStr.substring(1).trim() 
    : commandStr.trim();
    
  // Split into command and arguments
  const parts = cleanCommand.split(' ');
  const command = parts[0];
  const args = parts.slice(1);
  
  return { command, args };
}

// Execute a single command by fetching and running its process
async function executeCommand(command, args) {
  try {
    // Determine the appropriate process category based on command prefix
    let processCategory = "system"; // Default category
    
    // Check if this is a 00reaper-specific command
    if (command.startsWith('reaper-')) {
      processCategory = "00reaper";
    }
    // Check if this is a 1000xdev-specific command (future)
    else if (command.startsWith('dev-')) {
      processCategory = "1000xdev";
    }
    
    // Create the rule name for fetch_rules - MANDATORY step
    const ruleName = `processes/${processCategory}/${command}`;
    
    // Fetch the rule
    const fetchResult = await tools.call('fetch_rules', {
      rule_names: [ruleName],
      explanation: `Fetching process rule '${ruleName}' to execute as part of chain command.`
    });
    
    // If fetch_rules fails, this is a critical error
    if (!fetchResult) {
      return {
        success: false,
        message: `❌ Command '${command}' not found or could not be processed.`
      };
    }
    
    // The fetch_rules step above will load the process
    // Since we can't directly access the execution result, we'll return a success
    // The actual command will be executed through its process file
    
    return {
      success: true,
      message: `✅ Executed ${command} ${args.length > 0 ? 'with args: ' + args.join(' ') : ''}`
    };
  } catch (error) {
    return {
      success: false,
      message: `❌ Error executing ${command}: ${error.message}`
    };
  }
}

// Format the final results of the chain execution
function formatChainResults(commands, results, verbose) {
  let output = `✅ Executed command chain with ${results.length} commands\n\n`;
  
  // Calculate success rate
  const successCount = results.filter(r => r.success).length;
  const successRate = Math.round((successCount / results.length) * 100);
  
  output += `Success rate: ${successRate}% (${successCount}/${results.length})\n\n`;
  
  // Add detailed results if verbose
  if (verbose) {
    output += 'Command Results:\n';
    output += '---------------\n\n';
    
    results.forEach((result, index) => {
      output += `Command ${index+1}: ${commands[index]}\n`;
      output += `Status: ${result.success ? '✅ Success' : '❌ Failed'}\n`;
      
      if (result.result && result.result.message) {
        output += `Output: ${result.result.message}\n`;
      } else if (!result.success && result.error) {
        output += `Error: ${result.error}\n`;
      }
      
      output += '\n';
    });
  } else {
    // Just show a summary of results
    output += 'Results:\n';
    
    results.forEach((result, index) => {
      const icon = result.success ? '✅' : '❌';
      output += `${icon} ${commands[index]}\n`;
    });
  }
  
  return output;
}

// Format error messages
function formatError(message, suggestions = []) {
  let output = `❌ Error: ${message}\n\n`;
  
  if (suggestions && suggestions.length > 0) {
    output += 'Suggestions:\n';
    suggestions.forEach(suggestion => {
      output += `- ${suggestion}\n`;
    });
  }
  
  return output;
}
```

## Usage Examples

### Basic Command Chaining
```
> chain echo Hello | echo World
✅ Executed command chain with 2 commands

Success rate: 100% (2/2)

Results:
✅ echo Hello
✅ echo World
```

### Chaining with Verbose Output
```
> chain echo Hello | help echo --verbose
✅ Executed command chain with 2 commands

Success rate: 100% (2/2)

Command Results:
---------------

Command 1: echo Hello
Status: ✅ Success
Output: ✅ Hello

Command 2: help echo
Status: ✅ Success
Output: ✅ Help information for echo

```

### Error Handling in Chain
```
> chain echo Hello | unknown-command | echo World
✅ Executed command chain with 3 commands

Success rate: 67% (2/3)

Results:
✅ echo Hello
❌ unknown-command
✅ echo World
```

## Implementation Notes

This command enables basic command chaining functionality, a foundational feature for building more complex workflows. It executes each command sequentially and collects the results, providing either a summary or detailed output based on the verbose flag.

In a full implementation, the command would properly execute each process by:
1. Fetching the appropriate process file
2. Parsing and validating inputs
3. Executing the process with the given arguments
4. Formatting and passing results to the next command if needed

Future enhancements could include:
- Passing outputs from one command as inputs to the next
- Conditional execution based on success/failure
- Parallel execution of commands
- Storing chain results in state for later use 