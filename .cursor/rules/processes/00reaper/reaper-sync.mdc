/**
 * Calculate differences between source and target files
 */
function calculateDifferences(sourceFiles, targetFiles) {
  // Convert source files to target paths
  const sourceFilePaths = sourceFiles.map(file => {
    // Convert /00OS/path/file.md to /path/file.mdc
    const targetPath = file.relativePath.replace(/\.md$/, '.mdc');
    return targetPath;
  });
  
  // Get target file paths
  const targetFilePaths = targetFiles.map(file => file.relativePath);
  
  // Find new files (in source but not in target)
  const newFiles = sourceFiles.filter(file => {
    const targetPath = file.relativePath.replace(/\.md$/, '.mdc');
    return !targetFilePaths.includes(targetPath);
  });
  
  // Find orphaned files (in target but not in source)
  const orphanedFiles = targetFiles.filter(file => {
    const sourcePath = file.relativePath.replace(/\.mdc$/, '.md');
    return !sourceFilePaths.includes(sourcePath);
  });
  
  // For modified files, we'd need to compare content
  // This is a simplified version
  const modifiedFiles = [];
  
  return {
    newFiles: newFiles.map(f => f.path),
    orphanedFiles: orphanedFiles.map(f => f.path),
    modifiedFiles: modifiedFiles
  };
}

