# Process: reaper-implement

## Description

This process acts as the primary implementation engine for 00OS development. It performs the following steps:

1. Loads the three core workflow files from the `00reaper/` directory:
   - `active-request.md` (requirements/WHAT)
   - `implementation-plan.md` (plan/HOW)
   - `cycle-status.md` (status/WHERE)
2. Synthesizes the current objective and requirements from these files.
3. Analyzes the requirements and plan against the loaded context (command standards, registry status, etc.).
4. Plans the necessary file modifications (creations or edits) to achieve the task.
5. Executes the planned changes using the `edit_file` tool if mode is "scaffold" or "full".
6. Updates relevant tracking files (like `command-registry.md`) if required by the task.
7. Reports a summary of actions taken and any errors encountered.

**Note:** This process relies on the three core workflow files as the single source of truth for requirements, plan, and status. It does not use `current-task.md`.

## Execution

```javascript
// --- Standard Formatting Helpers ---
function formatSuccess(message, data = null) {
  const formattedMessage = typeof message === 'string' 
    ? `✅ ${message}` 
    : JSON.stringify(message);
  
  const response = { success: true, message: formattedMessage };
  if (data) response.data = data;
  return response;
}

function formatError(message, code = "EXECUTION_ERROR", suggestions = []) {
  const formattedMessage = typeof message === 'string' 
    ? `❌ Error [${code}]: ${message}` 
    : `❌ Error [${code}]: ${JSON.stringify(message)}`;
  
  const response = { 
    success: false, 
    message: formattedMessage,
    code: code 
  };
  
  if (suggestions && suggestions.length > 0) {
    response.message += "\n\nSuggestions:";
    suggestions.forEach(suggestion => {
      response.message += `\n- ${suggestion}`;
    });
  }
  
  return response;
}

function formatWarning(message) {
  return `⚠️ Warning: ${message}`;
}

// --- Implementation-Specific Helpers ---
/**
 * Read and validate a workflow file
 * @param {string} filePath - Path to the workflow file
 * @returns {Promise<string>} - The content of the file
 * @throws {Error} - If the file cannot be read
 */
async function readWorkflowFile(filePath) {
  try {
    tools.log(`Reading workflow file: ${filePath}...`);
    const readResult = await tools.call('read_file', {
      target_file: filePath,
      should_read_entire_file: true,
      explanation: `Reading workflow file: ${filePath}`
    });
    if (!readResult || readResult.content === undefined) {
      throw new Error(`Could not read file or received invalid response`);
    }
    if (!readResult.content || !readResult.content.trim()) {
      throw new Error(`File is empty or contains only whitespace`);
    }
    tools.log(`File read successfully (${filePath}).`);
    return readResult.content;
  } catch (error) {
    let errorCode = "FILE_READ_ERROR";
    let errorMsg = `Failed to read ${filePath}: ${error.message}`;
    let suggestions = [
      `Ensure the file exists at ${filePath}`,
      "Run > reaper-os-commands-workflow to initialize or update the workflow files"
    ];
    tools.error(errorMsg);
    throw {
      message: errorMsg,
      code: errorCode,
      suggestions: suggestions
    };
  }
}

/**
 * Synthesizes the current task from the three core workflow files
 * @returns {Promise<Object>} - An object containing requirements, plan, and status
 */
async function synthesizeCurrentTask() {
  const files = [
    { key: 'requirements', path: '00reaper/active-request.md' },
    { key: 'plan', path: '00reaper/implementation-plan.md' },
    { key: 'status', path: '00reaper/cycle-status.md' }
  ];
  const result = {};
  for (const file of files) {
    try {
      result[file.key] = await readWorkflowFile(file.path);
    } catch (error) {
      throw {
        message: `Failed to load ${file.path}: ${error.message}`,
        code: error.code || 'WORKFLOW_FILE_ERROR',
        suggestions: error.suggestions || []
      };
    }
  }
  return result;
}

/**
 * Analyzes the synthesized task and generates an implementation plan
 * @param {Object} taskContext - { requirements, plan, status }
 * @returns {Promise<Array>} - Array of planned actions
 */
async function analyzeTaskAndGeneratePlan(taskContext) {
  tools.log(`Analyzing synthesized task and generating implementation plan...`);
  // [AI logic to analyze requirements and plan, and generate a plan]
  // This should parse the requirements and plan, and generate edit_file actions as needed
  // For demonstration, return an empty plan
  return [];
}

/**
 * Execute the implementation plan based on the selected mode
 * @param {Array} plan - The array of planned actions
 * @param {string} mode - The implementation mode (plan, scaffold, full)
 * @returns {Object} - Results of plan execution
 */
async function executeImplementationPlan(plan, mode) {
  tools.log(`Executing implementation plan in ${mode} mode with ${plan.length} action(s)...`);
  const actionsTaken = [];
  const errorsEncountered = [];

  if (mode === "plan") {
    const planSummary = plan.map(action => 
      `- Would execute ${action.tool} on ${action.params.target_file} with instruction: "${action.params.instructions}"`
    ).join('\n');
    return {
      actionsTaken: [`Generated implementation plan with ${plan.length} action(s)`],
      errorsEncountered: [],
      planDetails: planSummary
    };
  }

  for (const action of plan) {
    try {
      tools.log(`Executing ${action.tool} for target: ${action.params.target_file}`);
      const result = await tools.call(action.tool, action.params);
      if (!result) {
        throw new Error(`No result returned from ${action.tool} tool call.`);
      }
      if (result.success === false || result.error) {
        throw new Error(result.error || result.message || `Tool call ${action.tool} failed.`);
      }
      actionsTaken.push(`Executed ${action.tool} on ${action.params.target_file}. Instruction: "${action.params.instructions}"`);
      tools.log(`Action completed successfully.`);
    } catch(error) {
      const targetFile = action.params.target_file;
      const errorMsg = `Failed action: ${action.tool} on ${targetFile}. Reason: ${error.message}`;
      tools.error(errorMsg);
      let suggestions = [];
      if (error.message.includes("not found") || error.message.includes("No such file")) {
        suggestions.push(`Verify that the target file path "${targetFile}" is correct`);
        suggestions.push(`Check if the directory for "${targetFile}" exists and create it if needed`);
      }
      errorsEncountered.push({
        message: errorMsg,
        file: targetFile,
        tool: action.tool,
        suggestions: suggestions
      });
      if (mode === "full" && errorsEncountered.length > 2) {
        tools.log(`Too many errors (${errorsEncountered.length}), stopping execution`);
        break;
      }
      if (mode === "full" && action.tool === "edit_file" && 
          targetFile.includes("00os/processes") && 
          !error.message.includes("not found")) {
        tools.log(`Critical error encountered while editing core process file. Stopping execution.`);
        break;
      }
    }
  }
  return {
    actionsTaken,
    errorsEncountered
  };
}

function validateImplementationMode(mode) {
  const validModes = ["plan", "scaffold", "full"];
  const normalizedMode = (mode || "plan").toLowerCase().trim();
  if (!validModes.includes(normalizedMode)) {
    throw {
      message: `Invalid implementation mode: ${mode}. Valid options are: ${validModes.join(", ")}`,
      code: "VALIDATION_ERROR",
      suggestions: [
        `Use one of the valid modes: ${validModes.join(", ")}`,
        "Example: > reaper-implement --mode=scaffold",
        "Use plan mode to preview changes without making them",
        "Use scaffold mode to create file structures with partial implementation",
        "Use full mode to implement complete functionality"
      ]
    };
  }
  return normalizedMode;
}

// --- Main Execution Function ---
async function execute(args, flags) {
  let mode;
  const actionsTaken = [];
  const errorsEncountered = [];
  try {
    try {
      mode = validateImplementationMode(flags.mode);
      tools.log(`Using implementation mode: ${mode}`);
    } catch (error) {
      return formatError(error.message, error.code || "VALIDATION_ERROR", error.suggestions || [
        "Use one of the valid modes: plan, scaffold, full",
        "Example: > reaper-implement --mode=scaffold"
      ]);
    }
    let taskContext;
    try {
      taskContext = await synthesizeCurrentTask();
      actionsTaken.push(`Loaded requirements, plan, and status from core workflow files.`);
    } catch (error) {
      return formatError(
        `Critical error: ${error.message}`, 
        error.code || "WORKFLOW_FILE_ERROR", 
        error.suggestions || [
          "Ensure all three core workflow files exist in 00reaper/",
          "Run > reaper-os-commands-workflow to initialize or update the workflow files"
        ]
      );
    }
    let plan;
    try {
      plan = await analyzeTaskAndGeneratePlan(taskContext);
      actionsTaken.push(`Generated implementation plan with ${plan.length} action(s).`);
    } catch (error) {
      return formatError(
        `Failed to generate implementation plan: ${error.message}`,
        error.code || "ANALYSIS_ERROR",
        error.suggestions || [
          "Verify the requirements and plan are clear and actionable in the workflow files",
          "Ensure the files contain required sections",
          "Run > reaper-read-files to ensure all context is loaded"
        ]
      );
    }
    const executionResult = await executeImplementationPlan(plan, mode);
    actionsTaken.push(...executionResult.actionsTaken);
    if (executionResult.errorsEncountered?.length > 0) {
      executionResult.errorsEncountered.forEach(error => {
        if (typeof error === 'string') {
          errorsEncountered.push(error);
        } else {
          let errorMsg = error.message || 'Unknown error';
          if (error.suggestions?.length > 0) {
            errorMsg += ` (Suggestions: ${error.suggestions.join('; ')})`;
          }
          errorsEncountered.push(errorMsg);
        }
      });
    }
    let summary = `Implementation ${mode === "plan" ? "plan" : "execution"} completed.\n\nActions Taken (${actionsTaken.length}):\n`;
    actionsTaken.forEach(action => summary += `- ${action}\n`);
    if (mode === "plan" && executionResult.planDetails) {
      summary += `\nImplementation Plan:\n${executionResult.planDetails}\n`;
    }
    if (errorsEncountered.length > 0) {
      summary += `\nErrors Encountered (${errorsEncountered.length}):\n`;
      errorsEncountered.forEach(error => summary += `- ${error}\n`);
      return formatError(summary, "PARTIAL_FAILURE", [
        "Review errors and logs.",
        "Verify any file changes that were made.",
        "Update the workflow files and retry if necessary.",
        `Consider using --mode=scaffold to make partial progress.`,
        `Run with --mode=plan first to identify potential issues before execution.`
      ]);
    } else {
      return formatSuccess(summary, {
        actionCount: actionsTaken.length,
        mode: mode,
        filesModified: plan.map(action => action.params.target_file)
      });
    }
  } catch (error) {
    const errorMessage = error.message || 'Unknown error occurred';
    tools.error(`Unexpected error in reaper-implement: ${errorMessage}`);
    const errorDetails = error.stack ? `\n${error.stack}` : '';
    return formatError(
      `Unexpected error during implementation: ${errorMessage}${errorDetails}`, 
      "EXECUTION_ERROR", 
      [
        "Check system logs for detailed error information.",
        "Ensure the context files are properly loaded (run reaper-read-files first).",
        "Try again with --mode=plan to diagnose issues without making changes.",
        "Verify that all required directories exist.",
        "Check file permissions if file operations are failing."
      ]
    );
  }
}

// Call the main execution function with parsed inputs
execute(inputs.args || [], inputs.flags || {});
```

## Example Usage

### Generate Implementation Plan
```
> reaper-implement --mode=plan
```

### Generate Implementation Scaffolding
```
> reaper-implement --mode=scaffold
```

### Generate Full Implementation
```
> reaper-implement --mode=full
```

